UPSERT species:`apple` CONTENT { bioclip_label: 'Malus domestica with common name apple', classifier_supported: false, common_names: ['Apple'], profile: 'label_only', reference_images: [], reviewed_by: 'sam-michaels', scientific_name: 'Malus domestica', sources: [] } RETURN NONE;
UPSERT species:`corn` CONTENT { bioclip_label: 'Zea mays with common name corn', classifier_supported: false, common_names: ['Corn', 'Maize'], profile: 'label_only', reference_images: [], reviewed_by: 'sam-michaels', scientific_name: 'Zea mays', sources: [] } RETURN NONE;
UPSERT species:`grape` CONTENT { bioclip_label: 'Vitis vinifera with common name grape', classifier_supported: false, common_names: ['Grape'], profile: 'label_only', reference_images: [], reviewed_by: 'sam-michaels', scientific_name: 'Vitis vinifera', sources: [] } RETURN NONE;
UPSERT species:`pepper` CONTENT { bioclip_label: 'Capsicum annuum with common name bell pepper', classifier_supported: false, common_names: ['Pepper', 'Bell pepper'], profile: 'label_only', reference_images: [], reviewed_by: 'sam-michaels', scientific_name: 'Capsicum annuum', sources: [] } RETURN NONE;
UPSERT species:`tomato` CONTENT { bioclip_label: 'Solanum lycopersicum with common name tomato', care: { hardiness_zones: 'annual', light: 'full_sun', notes: 'Tomatoes grow in most soils that drain moderately well and do best in deep, loamy, well-drained soil. Plenty of organic matter can raise yield and cut down on problems. They like slightly acidic soil, pH 6.0 to 6.8, but can grow in slightly alkaline soil. Spacing depends on how you grow them - staked plants and compact (determinate) types about 45 to 60 cm apart, caged plants 60 to 90 cm, plants left to sprawl 90 to 120 cm, with rows 120 to 150 cm apart. Where pith necrosis has struck, Clemson suggests about 90 cm, so the plants get more air and their leaves dry faster after dew or rain. Give plants at least six hours of direct sun a day, or they make few blossoms. Water in the morning, at the soil around the plants rather than over the leaves. Sandy soil needs water more often, but less each time. Keep the soil from drying out, or blossoms dry and fall. Blossoms drop without setting fruit when it stays below about 13 °C or above about 32 °C for long periods. For heat tolerance, Clemson Extension in South Carolina suggests Arkansas Traveler, Talladega Hybrid, Homestead 24, Bella Rosa Hybrid, Top Gun Hybrid, Solar Fire Hybrid, Florida 91 Hybrid, Sioux and Costoluto Genovese. Too much nitrogen gives lots of leaves but few flowers and fruit. If this happens, use a fertilizer without nitrogen that supplies phosphorus, and follow its label. Do not plant tomatoes, potatoes, peppers or eggplants in the same spot more than once every three years. A grass-family crop such as corn is a good crop to grow before tomatoes. Use certified seeds and plants when you can.', soil_ph: { max: 6.8, min: 6.0 }, spacing_cm: 60, water: 'medium' }, classifier_supported: false, common_names: ['Tomato'], profile: 'full', reference_images: [], reviewed_by: 'sam-michaels', scientific_name: 'Solanum lycopersicum', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_growing_tomatoes_home_garden`] } RETURN NONE;
DELETE disease WHERE id NOT IN [disease:`tomato_bacterial_speck`, disease:`tomato_bacterial_spot`, disease:`tomato_blossom_end_rot`, disease:`tomato_early_blight`, disease:`tomato_hornworms`, disease:`tomato_late_blight`, disease:`tomato_leaf_mold`, disease:`tomato_septoria_leaf_spot`, disease:`tomato_spider_mites`, disease:`tomato_whiteflies`, disease:`tomato_yellow_leaf_curl_virus`] RETURN NONE;
UPSERT disease:`tomato_bacterial_speck` CONTENT { conditions: { notes: 'Splashing water, wind-driven rain and storm mists spread the bacteria. Cool weather and stressed plants, as in early plantings, make it worse. The bacteria enter through natural openings and through wounds from wind-blown soil, insects, pruning, tools and handling.' }, damage_patterns: [], indicators: [{ discriminating: true, id: 'tomato_bacterial_speck.tiny_leaf_specks_size', image_kinds: ['leaf_closeup'], measure: { max: 2, quantity: 'lesion_diameter_mm', stat: 'median' }, question: 'Are the spots tiny specks, no bigger than a pinhead?', text: 'Leaf specks are tiny, usually no more than 2 mm across, smaller than bacterial spot\'s leaf spots.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_speck.black_leaf_specks', image_kinds: ['leaf_closeup'], question: 'Are there black specks on the leaves?', text: 'Black specks on the leaves.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_speck.yellow_halo', image_kinds: ['leaf_closeup'], question: 'Is there a yellow ring around the black specks on the leaves?', text: 'A yellow halo usually surrounds each black leaf speck.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_speck.specks_near_leaf_edges', image_kinds: ['leaf_closeup'], question: 'Are most of the black specks near the edges of the leaves?', text: 'Specks are often bunched near the leaf edges.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_bacterial_speck.leaf_distortion', image_kinds: ['leaf_closeup'], question: 'Are the leaves with specks bent, puckered or misshapen?', text: 'Leaves with specks are sometimes distorted, because the infection stops the leaf from growing evenly.', weight: 1, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_speck.specks_merge_leaflets_die', image_kinds: ['leaf_closeup', 'whole_plant'], question: 'Have many specks run together and are whole leaflets dead?', text: 'When specks are many, they may run together and whole leaflets may die.', weight: 1, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_speck.stunted_seedlings', image_kinds: ['whole_plant'], question: 'Is the young seedling small and stunted compared with healthy ones?', text: 'Badly infected seedlings may be stunted.', weight: 1, where: 'whole_plant' }, { discriminating: true, id: 'tomato_bacterial_speck.black_fruit_specks', image_kinds: ['flower_fruit'], question: 'Are there tiny pinpoint black specks on the tomato fruit that are only slightly raised, not rough or scabby?', text: 'Tiny pinpoint black specks on the fruit, only slightly raised and not scabby, often with a narrow green to yellow ring. They sit on the surface and can be scraped off with a fingernail. Only young green fruit gets infected, but the black specks stay after the fruit ripens.', weight: 3, where: 'fruit' }], kind: 'bacterial', name: 'Bacterial speck', prevalence: 'common', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`ontario_tomato_bacterial_diseases`] } RETURN NONE;
UPSERT disease:`tomato_bacterial_spot` CONTENT { conditions: { notes: 'Favoured by warm, humid, wet weather; most outbreaks follow heavy rainstorms. Splashing rain, overhead watering and touching or handling wet plants spread the bacteria. They survive the winter on volunteer tomatoes and infected plant debris, and enter fruit through insect punctures and other wounds.' }, damage_patterns: [], indicators: [{ discriminating: false, id: 'tomato_bacterial_spot.water_soaked_angular_leaf_spots', image_kinds: ['leaf_closeup'], question: 'Does the leaf have many small dark spots with uneven or angular edges that look wet or water-soaked?', text: 'Many small, angular to irregular, dark spots on the leaves that look water-soaked at first.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_bacterial_spot.leaf_spot_size', image_kinds: ['leaf_closeup'], measure: { max: 5, min: 3, quantity: 'lesion_diameter_mm', stat: 'max' }, question: 'Are the biggest spots clearly larger than a pinhead, but still small?', text: 'The largest leaf spots grow to about 3 to 5 mm across, bigger than the tiny specks of bacterial speck.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_spot.yellow_halo', image_kinds: ['leaf_closeup'], question: 'Is there a yellow ring around the small dark spots on the leaf?', text: 'Leaf spots may have a yellow halo around them.', weight: 1, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_bacterial_spot.spot_centres_tear_holes', image_kinds: ['leaf_closeup'], question: 'Have the spots dried out and torn, leaving holes so the leaf looks ragged?', text: 'Spot centres turn brown, dry out and tear, leaving holes. The leaves look tattered.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_spot.spots_on_leaf_edges_tip', image_kinds: ['leaf_closeup'], question: 'Are most of the spots near the edges and tip of the leaf?', text: 'Spots tend to gather on the leaf edges and tip.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_spot.spots_merge_scorched', image_kinds: ['leaf_closeup'], question: 'Have the spots joined together so parts of the leaf look burnt or scorched?', text: 'Spots may join together, so the leaf looks blighted or scorched.', weight: 1, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_bacterial_spot.lower_leaf_yellowing_defoliation', image_kinds: ['whole_plant'], question: 'Are the lower leaves of the plant yellow, dead or fallen off?', text: 'When spots are many, leaves turn yellow and die, and the lower part of the plant loses its leaves.', weight: 2, where: 'whole_plant' }, { discriminating: true, id: 'tomato_bacterial_spot.raised_scabby_fruit_spots', image_kinds: ['flower_fruit'], question: 'Does the tomato fruit have raised, rough or scabby dark spots that are bigger than tiny pinpoint specks?', text: 'Raised, rough, scabby spots on the fruit, bigger than pinpoint specks. They start as small dark brown to black raised spots on green fruit and can grow and turn brown and greasy-looking.', weight: 3, where: 'fruit' }, { discriminating: false, id: 'tomato_bacterial_spot.fruit_spot_white_halo', image_kinds: ['flower_fruit'], question: 'Do the dark spots on the green fruit have a white ring around them?', text: 'Young fruit spots may have a white halo, which fades as the fruit ages.', weight: 1, where: 'fruit' }], kind: 'bacterial', name: 'Bacterial spot', prevalence: 'common', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_bacterial_spot_pepper_tomato`, source:`ontario_tomato_bacterial_diseases`] } RETURN NONE;
UPSERT disease:`tomato_blossom_end_rot` CONTENT { conditions: { notes: 'Favoured by big swings in soil moisture, wet, overcast and humid spells, and cool temperatures, especially early in the season. Low soil calcium, root damage from hoeing or digging near the plants, and too much ammonium nitrogen, potassium or magnesium fertiliser also raise the risk.' }, damage_patterns: [], indicators: [{ discriminating: true, id: 'tomato_blossom_end_rot.water_soaked_blossom_end_spot', image_kinds: ['flower_fruit'], question: 'Is there a wet-looking, soaked spot on the bottom tip of the fruit, the end away from the stem?', text: 'Spots that look wet or soaked with water, at the flower end of the fruit, opposite the stem.', weight: 2, where: 'fruit' }, { discriminating: true, id: 'tomato_blossom_end_rot.blossom_end_spot_black', image_kinds: ['flower_fruit'], question: 'Is there a large black patch on the bottom tip of the fruit?', text: 'The spots on the blossom end grow larger and turn black.', weight: 2, where: 'fruit' }, { discriminating: true, id: 'tomato_blossom_end_rot.secondary_rot', image_kinds: ['flower_fruit'], question: 'Does the dark patch on the bottom of the fruit look rotten or decayed?', text: 'Rot from other decay organisms usually sets in on the damaged blossom end.', weight: 2, where: 'fruit' }], kind: 'abiotic', name: 'Blossom-end rot', prevalence: 'common', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_diseases`] } RETURN NONE;
UPSERT disease:`tomato_early_blight` CONTENT { conditions: { notes: 'High temperature and humidity while spots are forming let the disease kill much of the foliage. Between seasons it lives on in old infected plant bits in the soil, in seed, in self-sown tomatoes and in related plants such as potato, eggplant and black nightshade.' }, damage_patterns: [], indicators: [{ discriminating: false, id: 'tomato_early_blight.brown_spots_older_leaves', image_kinds: ['leaf_closeup', 'whole_plant'], question: 'Are there small brown spots on the lower, older leaves?', text: 'Small brown spots appear first, mostly on the older, lower leaves.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_early_blight.concentric_rings_bullseye', image_kinds: ['leaf_closeup'], question: 'Do the brown spots have dark rings inside them, like a target?', text: 'As spots grow, dark rings form inside them in a bull\'s-eye or target pattern.', weight: 3, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_early_blight.yellow_halo_around_spots', image_kinds: ['leaf_closeup'], question: 'Is the leaf yellow around the brown spots?', text: 'The leaf tissue around the spots often turns yellow, like a yellow halo.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_early_blight.spots_become_angular', image_kinds: ['leaf_closeup'], question: 'Are the larger brown spots angular, with straight edges, rather than round?', text: 'Spots get bigger and become angular over time.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_early_blight.much_foliage_killed', image_kinds: ['whole_plant'], question: 'Are many of the leaves on the plant dead and brown?', text: 'In hot, humid weather much of the foliage may be killed.', weight: 1, where: 'whole_plant' }, { discriminating: false, id: 'tomato_early_blight.stem_lesion_collar_rot', image_kinds: ['whole_plant'], question: 'Is there a dark spot circling the stem near the soil?', text: 'Spots like the leaf spots can form on stems. Near the soil line they sometimes circle the stem (collar rot).', weight: 1, where: 'stem' }, { discriminating: true, id: 'tomato_early_blight.large_fruit_lesion_rings', image_kinds: ['flower_fruit'], question: 'Does the fruit have a large dark spot with rings inside it?', text: 'Fruit spots grow large, often covering nearly the whole fruit, and show rings like the leaf spots.', weight: 2, where: 'fruit' }], kind: 'fungal', name: 'Early blight', prevalence: 'common', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_septoria_leaf_spot`, source:`ontario_tomato_bacterial_diseases`] } RETURN NONE;
UPSERT disease:`tomato_hornworms` CONTENT { conditions: { notes: 'Damage usually starts in midsummer and goes on until the end of the season. Heavy egg laying is common in August and early September (South Carolina). Eggs hatch in about four days, depending on temperature.' }, damage_patterns: ['chewed_margins'], indicators: [{ discriminating: true, id: 'tomato_hornworms.leaves_stripped', image_kinds: ['whole_plant'], question: 'Are parts of the plant stripped bare, with many leaves eaten away?', text: 'Leaves are eaten away, and parts of the plant are quickly stripped bare.', weight: 2, where: 'whole_plant' }, { discriminating: true, id: 'tomato_hornworms.large_green_caterpillar', image_kinds: ['whole_plant', 'leaf_closeup'], question: 'Is there a large, fat, green caterpillar on the plant?', text: 'A very large, fat, bright green caterpillar, about as thick as a thumb, is on the plant. It is the same colour as the leaves, so it is hard to see.', weight: 2, where: 'whole_plant' }, { discriminating: true, id: 'tomato_hornworms.horn_on_rear_end', image_kinds: ['whole_plant', 'leaf_closeup'], question: 'Does the caterpillar have a horn sticking out from its back end?', text: 'The caterpillar has a horn sticking out from its back end. The horn may be red and curved, or black and straight, or green.', weight: 3, where: 'whole_plant' }, { discriminating: false, id: 'tomato_hornworms.side_stripes_or_v_marks', image_kinds: ['whole_plant', 'leaf_closeup'], question: 'Does the green caterpillar have white slanted stripes or V-shaped marks along its sides?', text: 'The caterpillar has white slanted stripes or V-shaped marks along each side of its body.', weight: 2, where: 'whole_plant' }, { discriminating: false, id: 'tomato_hornworms.eggs_under_leaves', image_kinds: ['leaf_underside'], question: 'Are there tiny, smooth, round, pale green or white eggs on the underside of the leaf?', text: 'Smooth, round eggs, about 1.6 mm across, sit on the underside of leaves. They are light green at first and turn white before hatching.', weight: 2, where: 'leaf_underside' }, { discriminating: false, id: 'tomato_hornworms.open_scars_on_fruit', image_kinds: ['flower_fruit'], question: 'Does the fruit have large, open, eaten scars on its surface?', text: 'In heavy infestations, fruit has large, open scars where the caterpillars ate the surface. They do not bore inside. This is much less common than leaf loss.', weight: 1, where: 'fruit' }, { discriminating: false, id: 'tomato_hornworms.white_cocoons_on_back', image_kinds: ['whole_plant', 'leaf_closeup'], question: 'Does the caterpillar have many small white bumps sticking up from its back?', text: 'Some caterpillars carry many small white projections on their backs. These are the cocoons of tiny parasitic wasps.', weight: 2, where: 'whole_plant' }], kind: 'pest', name: 'Hornworms', prevalence: 'common', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`isu_tomato_hornworm`] } RETURN NONE;
UPSERT disease:`tomato_late_blight` CONTENT { conditions: { notes: 'Most damaging in cool, wet weather. The same source also says infection is ideal when days reach about 24 to 26 °C and humidity is high. Rain and wind spread the spores between plants and gardens.' }, damage_patterns: [], indicators: [{ discriminating: true, id: 'tomato_late_blight.dark_water_soaked_leaf_spots', image_kinds: ['leaf_closeup'], question: 'Are there small, dark spots on the leaf that look wet or soaked with water?', text: 'Young leaf spots are small, dark and look water-soaked.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_late_blight.spots_enlarge_quickly', image_kinds: ['leaf_closeup'], question: 'Have some of the dark spots grown into larger patches?', text: 'The leaf spots quickly grow into large dark patches.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_late_blight.white_mould_underside_margins', image_kinds: ['leaf_underside'], question: 'On the underside of the leaf, is there white, fuzzy mould along the edge of a dark patch?', text: 'White mould grows at the edges of the damaged areas on the underside of the leaves.', weight: 2, where: 'leaf_underside' }, { discriminating: false, id: 'tomato_late_blight.leaves_brown_shrivelled', image_kinds: ['whole_plant'], question: 'Are many of the plant\'s leaves brown and shrivelled?', text: 'Leaves turn brown and shrivel. The plant can lose all its leaves within about two weeks of the first symptoms.', weight: 2, where: 'whole_plant' }, { discriminating: false, id: 'tomato_late_blight.stems_brown_shrivelled', image_kinds: ['whole_plant'], question: 'Are the stems brown and shrivelled?', text: 'Stems turn brown and shrivel.', weight: 2, where: 'stem' }, { discriminating: false, id: 'tomato_late_blight.shiny_dark_olive_fruit_lesions', image_kinds: ['flower_fruit'], question: 'Does the tomato fruit have shiny, dark or olive-green patches?', text: 'Infected fruits get shiny, dark or olive-coloured patches, which may cover large areas of the fruit.', weight: 2, where: 'fruit' }, { discriminating: false, id: 'tomato_late_blight.rough_sunken_edge_fruit_lesions', image_kinds: ['flower_fruit'], question: 'Are the patches on the fruit rough, with edges that are slightly sunken?', text: 'Later the fruit patches turn rough, with their edges sunk in a little.', weight: 2, where: 'fruit' }], kind: 'fungal', name: 'Late blight', prevalence: 'occasional', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_diseases`, source:`ontario_tomato_bacterial_diseases`] } RETURN NONE;
UPSERT disease:`tomato_leaf_mold` CONTENT { conditions: { notes: 'Favoured by high relative humidity and high temperature. It starts where the air is still and humid. Spores spread by rain, wind or tools.' }, damage_patterns: [], indicators: [{ discriminating: false, id: 'tomato_leaf_mold.starts_on_lower_leaves', image_kinds: ['whole_plant'], question: 'Are the spotted leaves mostly the older, lower leaves near the soil?', text: 'The disease shows first on older leaves near the soil.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_leaf_mold.pale_spots_upper_surface', image_kinds: ['leaf_closeup'], question: 'Are there pale green or yellowish spots on the top side of the leaf?', text: 'Light green to yellowish spots on the top of the leaf.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_leaf_mold.spots_turn_yellow', image_kinds: ['leaf_closeup'], question: 'Are the spots on the top of the leaf a clear, bright yellow?', text: 'The spots grow larger and turn a distinctive yellow.', weight: 3, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_leaf_mold.gray_velvety_underside', image_kinds: ['leaf_underside'], question: 'Is there a gray, velvety, fuzzy growth on the underside of the leaf?', text: 'In humid weather, the spots on the leaf underside are covered with a gray, velvety growth of fungus spores.', weight: 2, where: 'leaf_underside' }, { discriminating: false, id: 'tomato_leaf_mold.spots_merge', image_kinds: ['leaf_closeup'], question: 'Have the spots joined together into large patches on the leaf?', text: 'In a severe infection, the spots join together.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_leaf_mold.foliage_killed', image_kinds: ['whole_plant'], question: 'Are many leaves on the plant dead?', text: 'In a severe infection, the leaves are killed.', weight: 2, where: 'whole_plant' }, { discriminating: false, id: 'tomato_leaf_mold.black_leathery_stem_end_rot', image_kinds: ['flower_fruit'], question: 'Does the fruit have a black, leathery rot at the stem end?', text: 'Sometimes green and ripe fruit get a black, leathery rot at the stem end.', weight: 1, where: 'fruit' }], kind: 'fungal', name: 'Leaf mold', prevalence: 'occasional', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_diseases`] } RETURN NONE;
UPSERT disease:`tomato_septoria_leaf_spot` CONTENT { conditions: { notes: 'Most active when humidity is high and rain or overhead watering wets the plants. It survives the winter on infected debris and on some weeds related to tomato.', temp_c: { max: 25, min: 20 } }, damage_patterns: [], indicators: [{ discriminating: false, id: 'tomato_septoria_leaf_spot.small_spot_size', image_kinds: ['leaf_closeup'], measure: { max: 6.4, min: 3.2, quantity: 'lesion_diameter_mm', stat: 'median' }, question: 'Are the spots small, only a few millimetres across?', text: 'The spots are small, about 3 to 6 mm across.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_septoria_leaf_spot.many_round_spots', image_kinds: ['leaf_closeup'], question: 'Does the leaf have many small round spots?', text: 'Many small, round spots on each affected leaf.', weight: 2, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_septoria_leaf_spot.tan_centre_dark_border', image_kinds: ['leaf_closeup'], question: 'Do the spots have a pale tan or whitish centre with a dark edge?', text: 'The spots have a light tan, beige or whitish centre with a dark brown border.', weight: 3, where: 'lower_leaves' }, { discriminating: true, id: 'tomato_septoria_leaf_spot.black_specks_in_centre', image_kinds: ['leaf_closeup'], question: 'Are there tiny black dots inside the pale centre of the spots?', text: 'Tiny black specks (spore bodies) sit in the pale centre of older spots. A hand lens shows them clearly.', weight: 3, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_septoria_leaf_spot.starts_on_lower_leaves', image_kinds: ['whole_plant', 'leaf_closeup'], question: 'Are the spots mostly on the lower, older leaves near the ground?', text: 'Spots start on the older, lower leaves near the ground, usually after the plant begins to set fruit.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_septoria_leaf_spot.spotted_leaves_yellow', image_kinds: ['whole_plant', 'leaf_closeup'], question: 'Are the leaves with many spots turning yellow or brown?', text: 'Badly spotted leaves turn yellow, then brown, and wither. Yellowing is rare until the spots are numerous.', weight: 2, where: 'lower_leaves' }, { discriminating: false, id: 'tomato_septoria_leaf_spot.lower_leaf_drop', image_kinds: ['whole_plant'], question: 'Have many lower leaves dropped off, leaving bare stems at the bottom of the plant?', text: 'Spotted leaves die and fall off, so the plant loses its leaves from the bottom up.', weight: 2, where: 'whole_plant' }], kind: 'fungal', name: 'Septoria leaf spot', prevalence: 'common', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_septoria_leaf_spot`, source:`ontario_tomato_bacterial_diseases`] } RETURN NONE;
UPSERT disease:`tomato_spider_mites` CONTENT { conditions: { notes: 'Favoured by hot, dry weather and drought. Severe damage usually shows in late summer after a hot, dry spell. Mites develop fastest at about 27 °C and like the hot, dry weather of summer and autumn, but can appear at any time of year. In Iowa they become active in April and May and stay active all summer.' }, damage_patterns: ['webbing'], indicators: [{ discriminating: true, id: 'tomato_spider_mites.fine_stippling', image_kinds: ['leaf_closeup', 'leaf_underside'], question: 'Is the leaf covered in many very tiny pale or yellowish-green dots, like fine speckles?', text: 'Fine flecking or stippling: very tiny pale or yellowish-green speckles where the mites have fed.', weight: 3, where: 'leaf_underside' }, { discriminating: true, id: 'tomato_spider_mites.mites_on_underside', image_kinds: ['leaf_underside'], question: 'Are there tiny oval mites on the underside of the leaf, pale green or yellowish, some with two dark spots?', text: 'Tiny oval mites, about the size of a full stop, on the leaf underside. Most are green, greenish-yellow or almost see-through, often with two dark spots; some are brown or orange-red.', weight: 3, where: 'leaf_underside' }, { discriminating: true, id: 'tomato_spider_mites.fine_webbing', image_kinds: ['leaf_underside', 'leaf_closeup'], question: 'Is there very fine, thin webbing on the leaves or stems?', text: 'Very fine strands of silk webbing on the leaves, mostly underneath, or on the stems.', weight: 3, where: 'leaf_underside' }, { discriminating: false, id: 'tomato_spider_mites.pale_grey_leaves', image_kinds: ['whole_plant'], question: 'Do the leaves look pale, greyish or yellowish overall?', text: 'Infested leaves turn pale, greyish or yellowish.', weight: 2, where: 'whole_plant' }, { discriminating: false, id: 'tomato_spider_mites.bronzing_bleaching', image_kinds: ['whole_plant'], question: 'Do the leaves look bronze-coloured or bleached?', text: 'With heavy feeding, leaves look bleached or turn bronze, yellow or grey.', weight: 2, where: 'whole_plant' }, { discriminating: false, id: 'tomato_spider_mites.dead_spots_advanced', image_kinds: ['leaf_closeup', 'leaf_underside'], question: 'Are there dead brown spots on the speckled leaves?', text: 'Dead brown spots appear on leaves when damage is advanced.', weight: 2, where: 'leaf_underside' }, { discriminating: false, id: 'tomato_spider_mites.leaf_drop', image_kinds: ['whole_plant'], question: 'Has the plant lost many of its leaves?', text: 'Damaged leaves may drop off; the plant can lose all its leaves if mites are not controlled.', weight: 1, where: 'whole_plant' }, { discriminating: false, id: 'tomato_spider_mites.petal_browning', image_kinds: ['flower_fruit'], question: 'Are the flower petals brown and withered, as if burned by a spray?', text: 'Open flowers have brown, withered petals that look like spray burn.', weight: 2, where: 'fruit' }], kind: 'pest', name: 'Spider mites', prevalence: 'common', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`edis_in286_sweetpotato_whitefly`, source:`edis_in307_twospotted_spider_mite`, source:`isu_two_spotted_spider_mite`] } RETURN NONE;
UPSERT disease:`tomato_whiteflies` CONTENT { conditions: { notes: 'The sweetpotato whitefly (Bemisia) is mainly a pest in warm tropical and warm temperate regions. Outdoors it survives the winter only as far north as South Carolina; further north, Canada included, it lives in greenhouses. Its eggs hatch in about a week at 25 °C. Large swarms can fly in from old, dying crops nearby and badly infest newly planted ones. In Florida, Bemisia rarely reaches outbreak numbers where no insecticides are used, because natural enemies keep it down.' }, damage_patterns: ['sticky_residue', 'sooty_mould'], indicators: [{ discriminating: true, id: 'tomato_whiteflies.adult_whiteflies_under_leaves', image_kinds: ['leaf_underside'], question: 'Are there tiny white flying insects with white wings under the leaves?', text: 'Tiny whitish-yellow insects with powdery white wings sit on the undersides of the leaves.', weight: 3, where: 'leaf_underside' }, { discriminating: true, id: 'tomato_whiteflies.scale_like_nymphs', image_kinds: ['leaf_underside'], question: 'Are there tiny flat, oval, pale yellow-green scales stuck under the leaves?', text: 'Tiny flat, oval, greenish-yellow, scale-like young whiteflies sit stuck to the undersides of the leaves and do not move.', weight: 2, where: 'leaf_underside' }, { discriminating: false, id: 'tomato_whiteflies.yellow_feeding_spots', image_kinds: ['leaf_closeup'], question: 'Are there small yellow spots on the leaves?', text: 'Yellow spots sometimes appear on leaves where whiteflies feed.', weight: 1, where: 'upper_leaves' }, { discriminating: false, id: 'tomato_whiteflies.sticky_honeydew', image_kinds: ['leaf_closeup'], question: 'Do the leaves look shiny or sticky, as if coated with syrup?', text: 'Leaves are coated with sticky, sugary honeydew that the whiteflies excrete.', weight: 2, where: 'upper_leaves' }, { discriminating: true, id: 'tomato_whiteflies.sooty_mould_patches', image_kinds: ['leaf_closeup'], question: 'Is there a black, powdery coating lying on the leaf surface, like soot?', text: 'Dark, black sooty mould grows in patches on the honeydew and covers the leaves.', weight: 2, where: 'upper_leaves' }, { discriminating: false, id: 'tomato_whiteflies.wilting_heavy_infestation', image_kinds: ['whole_plant'], question: 'Is the plant wilting?', text: 'Heavily infested plants wilt from the loss of sap.', weight: 2, where: 'whole_plant' }, { discriminating: false, id: 'tomato_whiteflies.irregular_ripening_streaks', image_kinds: ['flower_fruit'], question: 'Do the tomatoes have uneven colour, with streaks of unripe colour?', text: 'Fruit on heavily infested plants may colour unevenly, with streaks, and stay white and hard inside.', weight: 1, where: 'fruit' }], kind: 'pest', name: 'Whiteflies', prevalence: 'occasional', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`edis_in286_sweetpotato_whitefly`] } RETURN NONE;
UPSERT disease:`tomato_yellow_leaf_curl_virus` CONTENT { conditions: { notes: 'Its carrier, the sweetpotato whitefly (Bemisia), survives the winter outdoors only as far north as South Carolina; further north, Canada included, it lives in greenhouses. Upward leaf curl from heat, drought or wet soil (leaf roll) looks similar, mostly on older leaves.' }, damage_patterns: [], indicators: [{ discriminating: true, id: 'tomato_yellow_leaf_curl_virus.upward_leaf_curl', image_kinds: ['whole_plant'], question: 'Do the leaves curl upward at the edges?', text: 'Leaves curl upward.', weight: 3, where: 'whole_plant' }, { discriminating: true, id: 'tomato_yellow_leaf_curl_virus.yellow_leaf_margins', image_kinds: ['whole_plant'], question: 'Are the edges of the leaves yellow?', text: 'Leaf edges turn yellow.', weight: 3, where: 'whole_plant' }, { discriminating: true, id: 'tomato_yellow_leaf_curl_virus.small_leaves', image_kinds: ['whole_plant'], question: 'Are the leaves smaller than normal tomato leaves?', text: 'Leaves are smaller than normal.', weight: 2, where: 'whole_plant' }, { discriminating: false, id: 'tomato_yellow_leaf_curl_virus.stunted_plant', image_kinds: ['whole_plant'], question: 'Is the plant short and stunted for a tomato plant?', text: 'The plant is stunted.', weight: 2, where: 'whole_plant' }, { discriminating: false, id: 'tomato_yellow_leaf_curl_virus.flower_drop', image_kinds: ['flower_fruit', 'whole_plant'], question: 'Are the flowers falling off the plant before fruit forms?', text: 'Flowers drop off.', weight: 2, where: 'fruit' }, { discriminating: false, id: 'tomato_yellow_leaf_curl_virus.no_fruit', image_kinds: ['flower_fruit', 'whole_plant'], question: 'Does the plant have no fruit at all?', text: 'Plants infected early in their growth may form no fruit.', weight: 1, where: 'fruit' }], kind: 'viral', name: 'Tomato yellow leaf curl virus', prevalence: 'rare', reviewed_at: '2026-10-21', reviewed_by: 'sam-michaels', sources: [source:`clemson_hgic_tomato_diseases`, source:`edis_in286_sweetpotato_whitefly`] } RETURN NONE;
DELETE organism WHERE id NOT IN [organism:`hornworm`, organism:`parasitic_wasp`, organism:`predatory_mite`, organism:`two_spotted_spider_mite`, organism:`whitefly`] RETURN NONE;
UPSERT organism:`hornworm` CONTENT { bioclip_label: 'Manduca with common name hornworm', name: 'Hornworm', recognition: 'A large, bright green caterpillar, about as thick as a thumb and roughly 7.5–13 cm long when fully grown. It has a horn at its rear end. The tobacco hornworm has seven diagonal white stripes on each side and a curved red horn. The tomato hornworm has eight V-shaped markings on each side and a straight black horn. One source says the horn can also be green. It is well camouflaged on the leaves of tomato, pepper, eggplant and potato, where it strips foliage and may leave large open scars on fruit. Its eggs are smooth and round, about 1.6 mm across, light green turning white, and laid on the underside of leaves. One with white cocoons on its back has stopped feeding, and helpful wasps will hatch from it. Do not spray caterpillars that carry white cocoons.', reviewed_by: 'sam-michaels', role: 'pest', scientific_name: 'Manduca', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`isu_tomato_hornworm`], taxon_group: 'insect' } RETURN NONE;
UPSERT organism:`parasitic_wasp` CONTENT { bioclip_label: 'Braconidae with common name parasitic wasp', name: 'Parasitic wasp', recognition: 'Adults are small to medium-sized wasps, usually brown or black, though size and colour vary a lot. The easiest sign is on hornworms: small white projections sticking up from the caterpillar\'s back. These are the wasps\' pupal cases.', reviewed_by: 'sam-michaels', role: 'beneficial', scientific_name: 'Braconidae', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`isu_parasitic_wasps`], taxon_group: 'insect' } RETURN NONE;
UPSERT organism:`predatory_mite` CONTENT { bioclip_label: 'Phytoseiidae with common name predatory mite', name: 'Predatory mite', recognition: 'A tiny mite with longer legs than a spider mite. The front pair of legs often points forward. It moves about quickly and is more active than the spider mites it hunts. It is often red or orange, but colour alone does not tell it from a spider mite, which can be orange-red too.', reviewed_by: 'sam-michaels', role: 'beneficial', scientific_name: 'Phytoseiidae', sources: [source:`edis_in286_sweetpotato_whitefly`, source:`edis_in307_twospotted_spider_mite`], taxon_group: 'mite' } RETURN NONE;
UPSERT organism:`two_spotted_spider_mite` CONTENT { bioclip_label: 'Tetranychus urticae with common name two-spotted spider mite', name: 'Two-spotted spider mite', recognition: 'A tiny oval mite, about 0.4–0.5 mm long, barely visible without a hand lens. It is usually green, greenish-yellow, whitish or almost see-through, with two dark spots on its body; some are brown or orange-red. It sits mainly on the underside of leaves, often among fine silk webbing, on leaves with pale speckles.', reviewed_by: 'sam-michaels', role: 'pest', scientific_name: 'Tetranychus urticae', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`edis_in307_twospotted_spider_mite`, source:`isu_two_spotted_spider_mite`], taxon_group: 'mite' } RETURN NONE;
UPSERT organism:`whitefly` CONTENT { bioclip_label: 'Aleyrodidae with common name whitefly', name: 'Whitefly', recognition: 'Adults are tiny, about 1 mm long, with a light yellow body and powdery white wings. The sweetpotato (silverleaf) whitefly holds its wings close to the body like a tent or roof; the greenhouse whitefly and most others hold them more loosely, nearly flat. They sit and lay eggs on the undersides of leaves, often new leaves. The young (nymphs) are flat, oval, scale-like specks about 0.3–0.7 mm long, greenish-yellow to glassy yellow, stuck flat to the leaf underside.', reviewed_by: 'sam-michaels', role: 'pest', scientific_name: 'Aleyrodidae', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`edis_in286_sweetpotato_whitefly`], taxon_group: 'insect' } RETURN NONE;
DELETE treatment WHERE id NOT IN [treatment:`avoid_excess_potassium_magnesium`, treatment:`avoid_handling_wet_plants`, treatment:`avoid_wounding_plants`, treatment:`bt_hornworms`, treatment:`buy_predatory_mites`, treatment:`buy_whitefly_biocontrols_greenhouse`, treatment:`calcium_nitrate_sidedress_no_ammonium`, treatment:`check_mites_white_paper`, treatment:`clean_seed_and_transplants`, treatment:`control_weeds_and_volunteers`, treatment:`copper_preventive_bacterial`, treatment:`disinfect_tools_equipment`, treatment:`even_moisture_irrigation_mulch`, treatment:`fine_mesh_screen_greenhouse`, treatment:`fungicide_early_blight`, treatment:`fungicide_late_blight`, treatment:`fungicide_preventive`, treatment:`gypsum_preplant_ber`, treatment:`gypsum_sidedress_rescue`, treatment:`handpick_hornworms`, treatment:`hose_off_mites`, treatment:`inspect_transplants_mites`, treatment:`keep_foliage_dry`, treatment:`keep_plants_vigorous`, treatment:`leave_parasitized_hornworms`, treatment:`mulch_around_plants`, treatment:`no_compost_rotten_potatoes`, treatment:`oil_spray_whitefly_repellent`, treatment:`plant_at_recommended_date_ber`, treatment:`protect_natural_enemies`, treatment:`prune_and_stake_for_airflow`, treatment:`reflective_mulch_whiteflies`, treatment:`remove_ber_fruit`, treatment:`remove_crop_debris`, treatment:`remove_diseased_plants`, treatment:`remove_infected_leaves`, treatment:`resistant_cultivars_ber`, treatment:`resistant_cultivars_early_blight`, treatment:`resistant_cultivars_late_blight`, treatment:`resistant_cultivars_pto_speck`, treatment:`resistant_cultivars_tylcv`, treatment:`rotate_crops_3_years`, treatment:`site_morning_sun`, treatment:`soap_or_oil_spray`, treatment:`soil_test_lime_ber`, treatment:`soil_test_potassium_early_blight`, treatment:`space_plants_apart`, treatment:`uv_absorbing_greenhouse_film`] RETURN NONE;
UPSERT treatment:`avoid_excess_potassium_magnesium` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Do not overfeed with potassium or magnesium. They compete with calcium for uptake by the plant. Epsom salt is a magnesium source, so do not use it on garden soil unless a recent soil report shows a magnesium shortage.' } RETURN NONE;
UPSERT treatment:`avoid_handling_wet_plants` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_bacterial_spot_pepper_tomato`, source:`ontario_tomato_bacterial_diseases`], text: 'Do not touch or work among plants while the leaves are wet. Water and handling spread the bacteria from sick plants to healthy ones.' } RETURN NONE;
UPSERT treatment:`avoid_wounding_plants` CONTENT { kind: 'mechanical', sources: [source:`ontario_tomato_bacterial_diseases`], text: 'Avoid wounding plants. Bacteria get in through wounds from pruning, hoeing, handling and strong sprays, and working among plants while wounding them helps spread the disease.' } RETURN NONE;
UPSERT treatment:`bt_hornworms` CONTENT { kind: 'biological', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`isu_tomato_hornworm`], text: 'Spray a biological insecticide containing Bacillus thuringiensis (Bt), labelled for tomatoes. Follow the label. Do not spray caterpillars that carry white cocoons.' } RETURN NONE;
UPSERT treatment:`buy_predatory_mites` CONTENT { kind: 'biological', sources: [source:`edis_in307_twospotted_spider_mite`], text: 'Predatory mites that eat spider mites can be bought, for example Phytoseiulus persimilis, which eats all stages of spider mites.' } RETURN NONE;
UPSERT treatment:`buy_whitefly_biocontrols_greenhouse` CONTENT { kind: 'biological', sources: [source:`edis_in286_sweetpotato_whitefly`], text: 'In a greenhouse you cannot rely on natural enemies arriving on their own. You can buy whitefly enemies, such as the parasitic wasp Eretmocerus eremicus, the predatory mite Amblyseius swirskii, or the lady beetle Delphastus catalinae.' } RETURN NONE;
UPSERT treatment:`calcium_nitrate_sidedress_no_ammonium` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'When feeding beside or around the plants, avoid fertilisers with ammonium nitrogen, such as ammonium sulfate, ammonium nitrate and most complete (all-purpose) fertilisers. Ammonium competes with calcium. Calcium nitrate is usually the best choice. Follow the fertiliser label.' } RETURN NONE;
UPSERT treatment:`check_mites_white_paper` CONTENT { kind: 'cultural', sources: [source:`edis_in307_twospotted_spider_mite`, source:`isu_two_spotted_spider_mite`], text: 'Look for mites, cast skins and webbing under the leaves with a magnifying glass. Or hold a sheet of white paper under the leaves and tap them sharply: mites show up as tiny, slow-moving specks. Spray only when the leaves show the typical speckling and you find a dozen or more mites on the sheet.' } RETURN NONE;
UPSERT treatment:`clean_seed_and_transplants` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_bacterial_spot_pepper_tomato`, source:`ontario_tomato_bacterial_diseases`], text: 'Use certified disease-free seed and plants, and do not plant diseased seedlings or transplants that have not been checked. For bacterial speck and bacterial spot, use seed that has been disinfected; ask your seed supplier how it was treated.' } RETURN NONE;
UPSERT treatment:`control_weeds_and_volunteers` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`edis_in307_twospotted_spider_mite`, source:`isu_bacterial_spot_pepper_tomato`, source:`ontario_tomato_bacterial_diseases`], text: 'Pull weeds in and around the garden, and pull up volunteer tomato plants (ones that come up on their own); for late blight, pull volunteer potato plants too. Volunteer tomatoes and weeds can carry bacterial speck and bacterial spot. Tomato-family weeds carry these diseases: black nightshade (early blight, late blight, bacterial spot), Carolina horsenettle (late blight) and ground cherry (bacterial spot). Septoria leaf spot also survives the winter on some weeds related to tomato. Weeds also host whiteflies, which can bring tomato yellow leaf curl virus into the garden from nightshades and jimsonweed. Destroying weeds such as pokeweed, jimsonweed, wild blackberry and wild geranium cuts the number of spider mites that survive the winter.' } RETURN NONE;
UPSERT treatment:`copper_preventive_bacterial` CONTENT { kind: 'chemical', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_bacterial_spot_pepper_tomato`, source:`ontario_tomato_bacterial_diseases`], text: 'Copper is for prevention, not a cure. Start spraying a copper product labelled for tomatoes before any spots appear, while plants are young and before the main fruit set. If spots are already showing, it is too late to start this season: copper may slow the spread but will not clear an infection, so use the other steps now and plan copper for next season, starting before symptoms. Cover the leaves well and follow the label exactly, because too much copper damages plants. The label also says how many days to wait between spraying and picking; wait at least that long before you harvest. In some areas bacterial spot has become resistant to copper, so do not rely on copper alone.' } RETURN NONE;
UPSERT treatment:`disinfect_tools_equipment` CONTENT { kind: 'cultural', sources: [source:`ontario_tomato_bacterial_diseases`], text: 'Clean and disinfect tools, stakes, trays and other equipment. The bacteria live on their surfaces, and disinfectants kill them easily there. Do not use disinfectants on the plants, as they can damage them.' } RETURN NONE;
UPSERT treatment:`even_moisture_irrigation_mulch` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Keep the soil evenly moist by watering and mulching. Mulch keeps the soil cooler and more evenly moist, and it holds back weeds, so you hoe less near the plants and damage fewer roots.' } RETURN NONE;
UPSERT treatment:`fine_mesh_screen_greenhouse` CONTENT { kind: 'mechanical', sources: [source:`edis_in286_sweetpotato_whitefly`], text: 'In a greenhouse, cover openings with very fine mesh screen to keep whiteflies out. Increase ventilation as well, to lower the risk of other plant diseases.' } RETURN NONE;
UPSERT treatment:`fungicide_early_blight` CONTENT { kind: 'chemical', sources: [source:`clemson_hgic_tomato_diseases`], text: 'If the disease is severe, use a copper fungicide labelled for tomatoes. Follow the label. It also says how many days to wait between spraying and picking; wait at least that long before you harvest.' } RETURN NONE;
UPSERT treatment:`fungicide_late_blight` CONTENT { kind: 'chemical', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_growing_tomatoes_home_garden`, source:`isu_septoria_leaf_spot`, source:`ontario_tomato_bacterial_diseases`], text: 'Late blight spreads fast, carried by rain and wind from plant to plant and garden to garden, and can kill all the leaves soon after the first spots. Fungicides work by stopping spores from growing, so a spray protects leaves that are not infected yet. Use a copper fungicide labelled for tomatoes. Follow the label. It also says how many days to wait between spraying and picking; wait at least that long before you harvest.' } RETURN NONE;
UPSERT treatment:`fungicide_preventive` CONTENT { kind: 'chemical', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_septoria_leaf_spot`], text: 'Fungicides work as prevention, not as a cure: use them as a preventive programme, before the disease spreads. They seldom work alone, without the clean-up steps. Use a copper fungicide labelled for tomatoes. Read and follow the label. It also says how many days to wait between spraying and picking; wait at least that long before you harvest.' } RETURN NONE;
UPSERT treatment:`gypsum_preplant_ber` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'If the soil pH is right but calcium is low, dig gypsum (calcium sulfate) into the soil before planting. Follow the soil report and the product label.' } RETURN NONE;
UPSERT treatment:`gypsum_sidedress_rescue` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'If the soil was not tested and no lime or gypsum went in before planting, putting gypsum beside the plants during the season has helped. Follow the product label.' } RETURN NONE;
UPSERT treatment:`handpick_hornworms` CONTENT { kind: 'mechanical', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`isu_tomato_hornworm`], text: 'Pick off and destroy hornworms that are feeding. Leave any with white cocoons on their backs: they have stopped feeding, and helpful wasps will hatch from them. Hornworms do not hurt you. They are green like the leaves, so search carefully, especially when they are small.' } RETURN NONE;
UPSERT treatment:`hose_off_mites` CONTENT { kind: 'mechanical', sources: [source:`isu_septoria_leaf_spot`, source:`isu_two_spotted_spider_mite`, source:`ontario_tomato_bacterial_diseases`], text: 'For light infestations, spray the plant with a strong stream of water from the garden hose to knock mites off. Repeat on several days in a row. This wets and splashes the leaves, which spreads leaf spots and blights; skip it on plants that have them.' } RETURN NONE;
UPSERT treatment:`inspect_transplants_mites` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_insect_pests`], text: 'Check transplants carefully before you buy them and bring them home, so you do not bring in spider mites.' } RETURN NONE;
UPSERT treatment:`keep_foliage_dry` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_septoria_leaf_spot`, source:`ontario_tomato_bacterial_diseases`], text: 'Keep the leaves dry. Water at the base of the plants, for example with drip or furrow irrigation, rather than from above. If you must water from above, avoid doing it late in the day, and use low pressure so less water splashes: splashing carries spores and bacteria from leaf to leaf. Try to keep the leaves dry when you transplant, too.' } RETURN NONE;
UPSERT treatment:`keep_plants_vigorous` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`clemson_hgic_tomato_insect_pests`, source:`isu_two_spotted_spider_mite`, source:`ontario_tomato_bacterial_diseases`], text: 'Keep plants growing strongly. Stressed plants attract more insect pests, suffer more from spider mite feeding and catch diseases more easily. Plant in well-prepared, fertile beds that drain well, and after heavy rain get standing water away quickly. Mulch the plants, and water and feed them well; follow the fertiliser label.' } RETURN NONE;
UPSERT treatment:`leave_parasitized_hornworms` CONTENT { kind: 'biological', sources: [source:`clemson_hgic_tomato_insect_pests`], text: 'Leave caterpillars that carry white cocoons on their backs. They have stopped feeding, and the next generation of helpful wasps will hatch from them.' } RETURN NONE;
UPSERT treatment:`mulch_around_plants` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_septoria_leaf_spot`], text: 'Mulch around tomato plants. After transplanting, cover the soil with 5 to 10 cm of organic mulch, such as chopped tree leaves, grass clippings or straw. It acts as a barrier that stops spores splashing up from the soil, which matters most when you cannot rotate crops.' } RETURN NONE;
UPSERT treatment:`no_compost_rotten_potatoes` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Do not compost rotten store-bought potatoes.' } RETURN NONE;
UPSERT treatment:`oil_spray_whitefly_repellent` CONTENT { kind: 'chemical', sources: [source:`clemson_hgic_tomato_diseases`, source:`edis_in307_twospotted_spider_mite`], text: 'Spray a canola oil product labelled for tomatoes, as the label directs. It repels whiteflies, reduces their feeding and may reduce the spread of tomato yellow leaf curl virus. Oil can burn leaves: some varieties are more sensitive, and weather, fertilisers and additives can raise the risk.' } RETURN NONE;
UPSERT treatment:`plant_at_recommended_date_ber` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Plant tomatoes in late spring at the date recommended for your area.' } RETURN NONE;
UPSERT treatment:`protect_natural_enemies` CONTENT { kind: 'biological', sources: [source:`clemson_hgic_tomato_insect_pests`, source:`edis_in286_sweetpotato_whitefly`, source:`edis_in307_twospotted_spider_mite`], text: 'Helpful insects and mites keep many tomato pests down, so protect them and spray only when needed. Helpful insects, among them small wasps, control hornworms. Spider mites are eaten by predatory mites, small lady beetles, minute pirate bugs, predatory thrips and lacewing larvae. Colour alone does not tell predatory mites from spider mites, since both can be red or orange. Predatory mites have longer legs, often hold the front pair forward and move fast, so do not mistake them for pests. Whiteflies are killed by tiny parasitic wasps, lacewing larvae, minute pirate bugs, bigeyed bugs and small lady beetles; in Florida, where nothing is sprayed, these usually keep the sweetpotato whitefly low. An empty whitefly shell with a round hole means a helpful wasp hatched from it.' } RETURN NONE;
UPSERT treatment:`prune_and_stake_for_airflow` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_septoria_leaf_spot`, source:`ontario_tomato_bacterial_diseases`], text: 'Prune suckers and stake or trellis your plants so air moves through them and the leaves stay less humid. Pruning cuts let bacteria in, so for bacterial spot prune only when the plants are dry.' } RETURN NONE;
UPSERT treatment:`reflective_mulch_whiteflies` CONTENT { kind: 'mechanical', sources: [source:`clemson_hgic_tomato_diseases`, source:`edis_in286_sweetpotato_whitefly`], text: 'Lay a reflective mulch, silver or aluminium coloured, in the rows. It repels whiteflies and cuts their feeding.' } RETURN NONE;
UPSERT treatment:`remove_ber_fruit` CONTENT { kind: 'mechanical', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Pick off fruit that shows blossom-end rot.' } RETURN NONE;
UPSERT treatment:`remove_crop_debris` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`edis_in286_sweetpotato_whitefly`, source:`isu_bacterial_spot_pepper_tomato`, source:`isu_septoria_leaf_spot`, source:`ontario_tomato_bacterial_diseases`], text: 'At the end of the season, pull out the old tomato plants and remove as much plant debris as you can from the garden; bag it and throw it away. Many tomato diseases survive the winter on old debris, and old plants keep tomato yellow leaf curl virus and its whiteflies going between crops, so for that virus remove the other plants that get it as well. Break up any debris you cannot remove: till the soil well in autumn, or, for bacterial speck and bacterial spot, work it well into the top 15 cm of soil so it breaks down quickly.' } RETURN NONE;
UPSERT treatment:`remove_diseased_plants` CONTENT { kind: 'mechanical', sources: [source:`clemson_hgic_tomato_diseases`, source:`edis_in286_sweetpotato_whitefly`], text: 'Pull out diseased plants as soon as you see them, and destroy them or throw them away. For bacterial spot, also remove and throw away any diseased plant parts. Sick plants are a source of disease for healthy ones. For tomato yellow leaf curl virus, pull plants at the first symptoms and put them straight into a bag, so the whiteflies feeding on them do not spread; this may slow the spread of the virus.' } RETURN NONE;
UPSERT treatment:`remove_infected_leaves` CONTENT { kind: 'mechanical', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_septoria_leaf_spot`], text: 'Cut off infected lower leaves and branches as they appear, and throw them away.' } RETURN NONE;
UPSERT treatment:`resistant_cultivars_ber` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Grow tomato varieties with resistance to blossom-end rot.' } RETURN NONE;
UPSERT treatment:`resistant_cultivars_early_blight` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Grow tomato varieties that are resistant or tolerant to early blight.' } RETURN NONE;
UPSERT treatment:`resistant_cultivars_late_blight` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Grow tomato varieties that are resistant to late blight.' } RETURN NONE;
UPSERT treatment:`resistant_cultivars_pto_speck` CONTENT { kind: 'cultural', sources: [source:`ontario_tomato_bacterial_diseases`], text: 'Grow tomato varieties that carry the Pto gene. It gives resistance to bacterial speck race 0. Race 1 can still infect these plants, but it has not been an important problem on commercial farms.' } RETURN NONE;
UPSERT treatment:`resistant_cultivars_tylcv` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`edis_in286_sweetpotato_whitefly`], text: 'Grow tomato varieties that are resistant or tolerant to tomato yellow leaf curl virus.' } RETURN NONE;
UPSERT treatment:`rotate_crops_3_years` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_bacterial_spot_pepper_tomato`, source:`isu_septoria_leaf_spot`, source:`ontario_tomato_bacterial_diseases`], text: 'Use at least a 3-year rotation: grow tomatoes, or related crops such as potatoes, peppers and eggplant, in the same spot only once every 3 years. In between, grow crops that do not get these diseases; corn is a good choice. Many tomato diseases survive in old debris in the soil, and rotating keeps new plants away from it. For bacterial speck and bacterial spot, 3 years should be enough if the old tomato debris has been worked well into the top 15 cm of soil.' } RETURN NONE;
UPSERT treatment:`site_morning_sun` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Put your garden where it gets morning sun, so the leaves dry quickly.' } RETURN NONE;
UPSERT treatment:`soap_or_oil_spray` CONTENT { kind: 'chemical', sources: [source:`edis_in286_sweetpotato_whitefly`, source:`edis_in307_twospotted_spider_mite`, source:`isu_two_spotted_spider_mite`], text: 'If you need a spray, try insecticidal soap or canola oil labelled for tomatoes first. Of the sprays, they are the least toxic to people, other non-target organisms and the environment, and nothing stays active once they dry. But they kill any mite or insect they hit, helpful ones included, such as predatory mites. They work only where they touch, so cover the plant thoroughly, especially the undersides of the leaves, where spider mites and whiteflies live and sprays reach them poorly. For whiteflies, spray early, before they build up to large numbers, and aim at the young whiteflies; whiteflies resist many insecticides. Soap and oil can burn leaves: some varieties are more sensitive, and weather, fertilisers and additives can raise the risk. Use a product sold for plants: household soaps, detergents and kitchen oils work less reliably. Follow the label.' } RETURN NONE;
UPSERT treatment:`soil_test_lime_ber` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Have the soil tested. Lime it as the soil report advises, to bring the pH to 6.5 and give enough calcium. Lime works best when put down 3 to 6 months before planting and dug into the soil. Follow the soil report for other fertiliser before planting.' } RETURN NONE;
UPSERT treatment:`soil_test_potassium_early_blight` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`], text: 'Test the garden soil every year, keep potassium at a good level, lime as the soil test advises and side-dress with calcium nitrate; this makes early blight less severe. Follow the soil test and the fertiliser label.' } RETURN NONE;
UPSERT treatment:`space_plants_apart` CONTENT { kind: 'cultural', sources: [source:`clemson_hgic_tomato_diseases`, source:`isu_septoria_leaf_spot`], text: 'Space plants so they do not touch each other. The extra room lets air move between them, so the leaves stay less humid.' } RETURN NONE;
UPSERT treatment:`uv_absorbing_greenhouse_film` CONTENT { kind: 'mechanical', sources: [source:`edis_in286_sweetpotato_whitefly`], text: 'Cover a greenhouse with UV-absorbing plastic film. Whiteflies enter these greenhouses less often.' } RETURN NONE;
