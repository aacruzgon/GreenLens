6, -0.05949374, -0.0143250795, -0.015354101, 0.0044501945, -0.00909073, -0.041129425, 0.01775031, 0.0100203315, 0.013378461, -0.01245893, 0.07347958, 0.0043048766, -0.041464876, -0.028947275, -0.039687645, -0.012070761, 0.033381563, 0.012471674, 0.03661714, 0.020247595, 0.08415348, 0.007369328, -0.041044347, -0.15126498, 0.0097345235, 0.054702807, 0.049348164, -0.03272928, -0.05203784, -0.0067859218, -0.06347396, -0.018286783, 0.027492786, 0.015333058, 0.015932893, -0.0028464494, 0.008249243, 0.022364832, 0.024368063, -0.08689107, -0.018786816, -0.030716363, -0.112182915, -0.015067445, 0.01448023, 0.10506755, 0.023717774, -0.026125848, -0.017007748, 0.025962314, -0.068439744, -0.18611616, 0.0614065, 0.038811743, -0.074024476, 0.07837637, 0.075246006, -0.020536488, -0.04849814, 0.012996892, 0.006655088, -0.015475128, -0.033848073, 0.05974283, 0.036226567, 0.08257508, -0.035502914, -0.004298933, -0.03495595, 0.008672788, 0.008470631, -0.06014689, 0.01542715, 0.0022761882, 0.047357943, -0.03714718, 0.036533922, -0.0021163207, 0.02922798, 0.014624408, -0.00092538045, 0.009012664, 0.056290083, -0.031962402, -0.0049824975, 0.01909917, -0.093986146, 0.0192084], embedding_model: 'snowflake-arctic-embed-xs@d8c86521', organism: organism:`parasitic_wasp`, source: source:`isu_parasitic_wasps`, text: 'The parasitic wasps are not the stinging, social wasps more commonly encountered in and around houses (paper wasps, yellowjackets and hornets). Parasitic wasps generally do not sting and are not pests except for their occasional, annoying presence as accidental invaders in the house. They are harmless and beneficial because they provide some biological or natural control of other insects. Parasitic wasps use their stinger to lay eggs inside other insects and can sting if threatened or handled.', text_hash: 'f2698474a905bf28353857d8d346cd0f4fc598cf1a2dec4950292b29ec9a642c', topic: 'recognition' } RETURN NONE;
