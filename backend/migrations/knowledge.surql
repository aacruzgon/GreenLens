683415, 0.1227211, 0.0036219591, -0.10923112, -0.02002587, 0.042514395, -0.037264284, -0.0076518063, 0.015994426, 0.011440545, -0.05154996, 0.039756257, -0.059692446, 0.038245853, -0.016145458, -0.03404502, 0.016717864, -0.057555333, -0.020947818, -0.039566576, -0.0043704505, 0.108897775, 0.011519085, -0.024373205, 0.02418151, 0.006436145, -0.13380635, 0.005803478, -0.0008010642, 0.06076628, -0.022342332, 0.049124986, -0.00261343, -0.059464704, 0.08824361, -0.024695393, 0.043458987, 0.019814262, -0.02535497, -0.065674864, -0.027142528, 0.059033763, -0.035124313, 0.042013183, 0.04083313, -0.12833175, 0.018410403, 0.009304804, 0.12533656, 0.03309762, 0.072663836, 0.04511773, -0.009963261, -0.03284942, -0.08289379, 0.04078824, 0.0652167, 0.0066385944, 0.060107782, 0.00240583, -0.0121065965, -0.0007144373, 0.07951498, -0.038251996, 0.01201933, -0.058572706, 0.1391649, -0.008821965, 0.0094087655, -0.02163522, 0.10588086, 0.010783534, -0.0384602, 0.014954122, -0.013546302, -0.007190947, 0.0019228708, -0.058925454, -0.06678949, -0.034632146, -0.005717398, 0.049383897, -0.019848062, 0.013204799, -0.025512245, 0.020796796, -0.029486425, -0.0064373817, -0.049860656, -0.045118272, -0.0013086206], embedding_model: 'snowflake-arctic-embed-xs@d8c86521', source: source:`isu_cedar_apple_rust`, text: 'Cedar/juniper and apple trees are required to complete their disease cycle.\nApple trees will present small, yellow spots on the upper leaf surface shortly after bloom.\nThe fungus produces brown overwintering galls on the cedar twigs that swell during wet weather to form orange gelatinous structures with spores.\nSanitation along with properly timed fungicide sprays can be used to protect trees from infection.', text_hash: '91cefd770451016ce746ce843dea9814196d497655f40cce92507922c2e2cb7f', topic: 'conditions' } RETURN NONE;
