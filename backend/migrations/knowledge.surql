33154, 0.12101754, -0.0046035205, -0.019969862, -0.03360305, 0.013462383, -0.0077572535, -0.015084121, 0.028528089, -0.0039364994, 0.050002392, 0.034438197, -0.079520315, 0.07049144, 0.02459206, -0.0045365375, -0.019158471, -0.07742057, -0.019003551, 0.0013531429, 0.011710363, 0.08808658, -0.044978697, 0.066350766, -0.031248124, 0.0028107392, -0.18559156, -0.0056998665, 0.017015405, -0.010698414, -0.0076894816, 0.078708395, 0.008596676, -0.0076223933, -0.008703445, -0.06606941, 0.092729524, 0.03811357, -0.036967132, -0.046951033, 0.013754682, 0.0793182, -0.08617945, -0.012405015, 0.024974143, -0.18225285, -0.02180832, -0.008489322, 0.113022245, 0.0548353, 0.0047669527, 0.050622758, -0.024719423, -0.06881434, -0.10885957, 0.048721116, -0.00034603057, -0.063972235, 0.03606726, 0.027891302, -0.02335307, 0.05102875, 0.073178396, -0.06917447, -0.030363513, -0.016108278, 0.09912641, -0.011371021, -0.024865232, -0.02611396, 0.08605737, -0.027752833, 0.0029490248, -0.046877105, -0.05049877, 0.02922146, 0.00981685, -0.024088109, -0.052114356, 0.047980547, -0.020078523, 0.027186565, 0.0010132128, 0.0029006607, -0.0027474687, 0.045078564, -0.029239286, 0.013825507, -0.035255384, -0.0320822, 0.014367594], embedding_model: 'snowflake-arctic-embed-xs@d8c86521', source: source:`ontario_field_crop_diseases`, text: '•  Harvest as early as possible. •   If bird damage is evident, harvest outside damaged rows separately. Keep and handle the grain from these rows separately. •   Adjust harvest equipment to minimize damage to corn. •  Clean corn thoroughly to remove pieces of cob, small kernels and red dog. •  Cool the grain after drying. •  Clean bins before storing new grain. •   Check stored grain often for temperature, wet spots, insects and mould growth. •  Control storage insects. •  Exercise caution in feeding mouldy corn to livestock, especially to hogs. Pink or reddish moulds are particularly harmful. Suspect samples should be tested for toxins.\nSee Appendix D, Feed, Mould and Mycotoxin Testing Laboratories, for a list of laboratories.', text_hash: '40fa3ba381e2e5844e2c63945781a850b4200c05a985ca9412f429bfd6558764', topic: 'management' } RETURN NONE;
