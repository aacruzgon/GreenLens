, 0.1737421, -0.05643889, 0.030534776, -0.012497979, -0.0065288935, 0.017278967, -0.041133534, -0.023002777, -0.035388574, -0.03665357, -0.009331986, -0.022489216, -0.012293851, 0.084493205, -0.046911515, 0.006668413, -0.05898437, 0.018586213, 0.06483013, 0.018981894, 0.00036900022, -0.054248217, 0.047535285, -0.016645182, -0.006307427, -0.14955792, 0.0070141223, -0.020923132, 0.016896639, 0.01981692, 0.03501894, 0.014712906, -0.0525968, -0.04774618, -0.005196464, 0.017843502, -0.064397626, -0.046005007, -0.08360847, 0.024547448, 0.0010484332, -0.0712198, 0.03619763, -0.043017548, -0.11662587, 0.020661606, -0.008904829, 0.1320622, -0.011081293, 0.031975895, 0.0070675435, -0.0092892675, -0.04010404, -0.110395044, 0.06394539, 0.06893276, -0.017330933, 0.016272869, -0.008638748, -0.011790484, -0.002982661, 0.07670076, 0.021437274, 0.0025658666, 0.021759987, -0.023154737, 0.05353158, 0.05216209, -0.03866489, 0.11417299, -0.0062866933, -0.03874124, -0.0069717118, -0.0000146391985, -0.057019293, -0.019060778, 0.0129841985, -0.08793482, -0.041055102, -0.00016707569, 0.02507847, -0.0349372, 0.02299862, 0.032234315, 0.059463497, -0.0479744, -0.14279135, 0.007963085, -0.09437846, -0.058113508], embedding_model: 'snowflake-arctic-embed-xs@d8c86521', source: source:`edis_pp362_bacterial_spot_pepper`, text: 'Outbreaks are possible whenever warm weather occurs with frequent episodes of wind-driven rain as well as night temperatures above 65°F. These environmental conditions favor the likelihood of bacterial spot developing in pepper plantings. In southern Florida, the most severe outbreaks are observed in the months from August through November, coinciding with the rainy season.', text_hash: 'f95453de2ef237fc07d6361760032225108d339d96317524fa97d2cfc9bd5d84', topic: 'conditions' } RETURN NONE;
