7, 0.037790354, 0.035858706, -0.0061250264, 0.023592211, -0.048640285, -0.008298169, 0.014047439, -0.040806845, 0.0024728468, 0.04731794, -0.032965112, -0.009205531, -0.07125417, -0.0064345733, 0.0344894, -0.025304452, 0.08215026, -0.026865551, 0.014097002, -0.027166298, -0.02017956, -0.1347804, -0.05792016, -0.028265353, -0.009843241, -0.027883893, 0.07822736, -0.0009404168, -0.08122513, -0.009387261, -0.023266891, 0.031463023, 0.018464986, -0.02913954, -0.024997085, 0.018493526, 0.059605345, -0.05027903, 0.011495829, 0.04189841, -0.1288875, 0.008022236, -0.043543473, 0.12264238, -0.0031093352, 0.055489257, -0.026176615, -0.05108183, -0.040167063, -0.09818892, 0.019337675, 0.05339684, -0.043119006, 0.056234542, 0.0011137354, -0.0030130418, -0.031384714, -0.007820113, -0.007174673, 0.010770343, -0.030040754, 0.061881904, 0.058063645, 0.015973048, -0.015256312, 0.055382207, -0.075114965, 0.004062854, 0.008198306, -0.06960365, -0.07281376, -0.011947816, 0.008674127, -0.009061919, 0.003068178, -0.033381935, 0.013353072, -0.0052524703, -0.013481903, -0.027975373, 0.01495554, 0.022146694, -0.09035453, 0.0057170168, 0.007652387, 0.012807535], embedding_model: 'snowflake-arctic-embed-xs@d8c86521', organism: organism:`two_spotted_spider_mite`, source: source:`isu_two_spotted_spider_mite`, text: 'Mites feed externally on plant foliage. They use piercing-sucking mouthparts to puncture the plant tissue and feed on the liquid within the cells. Feeding injury causes the foliage to be discolored with very tiny yellowish-green speckles. Severe damage causes “bronzing” or "bleaching" and damaged leaves may drop off the plant. Close examination of infested foliage may reveal very fine webbing on the stems at the base of the needles.', text_hash: '5d9aa3b9e5542966b8b9b3a0e473b12629dae1d881637c5cf7eabf0e1b8a2db2', topic: 'symptoms' } RETURN NONE;
