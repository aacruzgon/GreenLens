UPSERT source:`ontario_tomato_bacterial_diseases` CONTENT { licence: 'Crown copyright. Non-commercial reproduction without changes, with credit; commercial use needs a licence. Credit: Janice LeBoeuf, Mike Celetti, Diane Cuppels, Jim Dick, Ron Pitblado and Steve Loewen; Ontario Ministry of Agriculture, Food and Agribusiness. © King\'s Printer for Ontario, 2012–2026.', publisher: 'Ontario Ministry of Agriculture, Food and Agribusiness', retrieved_at: '2026-10-19', title: 'Bacterial diseases of tomato: bacterial spot, bacterial speck and bacterial canker', url: 'https://www.ontario.ca/page/bacterial-diseases-tomato-bacterial-spot-bacterial-speck-and-bacterial-canker' } RETURN NONE;
