DELETE classifier_label WHERE id NOT IN [classifier_label:['disease-head-v3c-2026-10-20', 11], classifier_label:['disease-head-v3c-2026-10-20', 12], classifier_label:['disease-head-v3c-2026-10-20', 13], classifier_label:['disease-head-v3c-2026-10-20', 14], classifier_label:['disease-head-v3c-2026-10-20', 15], classifier_label:['disease-head-v3c-2026-10-20', 16], classifier_label:['disease-head-v3c-2026-10-20', 17], classifier_label:['disease-head-v3c-2026-10-20', 18]] RETURN NONE;
UPSERT classifier_label:['disease-head-v3c-2026-10-20', 11] CONTENT { label: 'tomato/healthy', species: species:`tomato` } RETURN NONE;
UPSERT classifier_label:['disease-head-v3c-2026-10-20', 12] CONTENT { label: 'tomato/tomato_bacterial_spot', problem: disease:`tomato_bacterial_spot`, species: species:`tomato` } RETURN NONE;
UPSERT classifier_label:['disease-head-v3c-2026-10-20', 13] CONTENT { label: 'tomato/tomato_early_blight', problem: disease:`tomato_early_blight`, species: species:`tomato` } RETURN NONE;
