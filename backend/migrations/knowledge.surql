UPSERT classifier_label:['disease-head-v3c-2026-10-20', 15] CONTENT { label: 'tomato/tomato_leaf_mold', problem: disease:`tomato_leaf_mold`, species: species:`tomato` } RETURN NONE;
UPSERT classifier_label:['disease-head-v3c-2026-10-20', 16] CONTENT { label: 'tomato/tomato_septoria_leaf_spot', problem: disease:`tomato_septoria_leaf_spot`, species: species:`tomato` } RETURN NONE;
UPSERT classifier_label:['disease-head-v3c-2026-10-20', 17] CONTENT { label: 'tomato/tomato_spider_mites', problem: disease:`tomato_spider_mites`, species: species:`tomato` } RETURN NONE;
UPSERT classifier_label:['disease-head-v3c-2026-10-20', 18] CONTENT { label: 'tomato/tomato_yellow_leaf_curl_virus', problem: disease:`tomato_yellow_leaf_curl_virus`, species: species:`tomato` } RETURN NONE;
DELETE soil_condition WHERE id NOT IN [soil_condition:['colour', 'pale'], soil_condition:['cover', 'bare'], soil_condition:['deposits', 'algae'], soil_condition:['deposits', 'moss'], soil_condition:['deposits', 'mould'], soil_condition:['deposits', 'salt_crust'], soil_condition:['erosion', 'rills'], soil_condition:['moisture', 'dry'], soil_condition:['moisture', 'waterlogged'], soil_condition:['moisture', 'wet'], soil_condition:['structure', 'cloddy'], soil_condition:['structure', 'compacted'], soil_condition:['surface', 'crusted'], soil_condition:['texture', 'clayey'], soil_condition:['texture', 'crumbles'], soil_condition:['texture', 'holds_ball'], soil_condition:['texture', 'loamy'], soil_condition:['texture', 'sandy'], soil_condition:['texture', 'silty'], soil_condition:['texture', 'sticky_ribbon'], soil_condition:['weeds', 'many']] RETURN NONE;
UPSERT soil_condition:['colour', 'pale'] CONTENT { description: 'The soil is light-coloured. At the same moisture, lighter soil usually holds less organic matter than darker soil. A patch lighter than the rest can mean topsoil has been lost, or subsoil dug up into it.', sources: [source:`ontario_field_crops_soil_management`, source:`csu_soil_compaction`], what_to_do: 'Add organic matter, such as compost, and keep the soil covered with mulch or plants. A lab soil test measures organic matter if you want a number.' } RETURN NONE;
UPSERT soil_condition:['cover', 'bare'] CONTENT { description: 'The soil is bare. Bare soil dries out fastest, crusts and erodes more easily, and leaves room for weeds.', sources: [source:`csu_mulching`, source:`ontario_field_crops_soil_management`], what_to_do: 'Mulch the bed, for example with wood chips around perennials and shrubs, or with dry grass clippings or shredded leaves in vegetable beds. Use clippings only from lawns not treated with herbicide. A cover of mulch or plants keeps the soil moist, protects it from rain, and suppresses weeds.' } RETURN NONE;
UPSERT soil_condition:['deposits', 'algae'] CONTENT { description: 'A green to blackish scum is on the soil. Algae grow where the surface stays wet, often in low, shaded or compacted spots, and the scum dries into a crust that cracks.', sources: [source:`isu_algae_lawn`], what_to_do: 'Let the surface dry out, water less often and not at night, and improve the drainage. Loosen compacted spots and let in more light.' } RETURN NONE;
UPSERT soil_condition:['deposits', 'moss'] CONTENT { description: 'Moss is growing on the soil. It doesn\'t harm plants, but it\'s a sign of damp, shady, poorly drained or compacted soil, or low fertility.', sources: [source:`isu_moss_lawn_garden`], what_to_do: 'Rake it off if you don\'t want it. To keep it from coming back, loosen the top few centimetres of soil now and then so the surface dries, and fix what it points to, such as shade, poor drainage or compaction. A soil test shows whether fertility is low.' } RETURN NONE;
UPSERT soil_condition:['deposits', 'mould'] CONTENT { description: 'A mould or fungus is growing on the soil or mulch. Most such growths feed on decaying organic matter, such as slime moulds, which start as yellow or orange foam and dry to a white powder. They don\'t harm plants.', sources: [source:`isu_fungi_landscape_mulch`], what_to_do: 'Leave it to dry up and fade, or scoop it up if it bothers you. Loosening the mulch so it dries out makes it less welcome. A fungicide isn\'t needed.' } RETURN NONE;
UPSERT soil_condition:['deposits', 'salt_crust'] CONTENT { description: 'A white crust is on the surface. Salts left behind as water evaporates can build up where water doesn\'t drain down through the soil. High salt makes it hard for roots to take up water and can burn leaf edges. Only a soil test can measure it.', sources: [source:`csu_saline_soils`, source:`csu_soil_drainage`], what_to_do: 'Where the soil drains, water deeply and slowly with clean water to wash salts below the roots; where it doesn\'t, improve the drainage first. Avoid fertilizer the soil doesn\'t need, and compost or manure that may be salty. Keep de-icing salt away from the bed.' } RETURN NONE;
UPSERT soil_condition:['erosion', 'rills'] CONTENT { description: 'Small channels have been cut into the soil by running water. Water is carrying topsoil away.', sources: [source:`ontario_field_crops_soil_management`, source:`csu_soil_drainage`, source:`csu_mulching`], what_to_do: 'Cover the soil with mulch or plants, which slow runoff and hold the soil. On a slope, a ground cover or turf does this best. Add organic matter over time so the soil takes in water more easily. Look for where the water comes from, such as overwatering, and lead it away.' } RETURN NONE;
UPSERT soil_condition:['moisture', 'dry'] CONTENT { description: 'The soil surface looks dry. Bare soil loses water fastest from its surface.', sources: [source:`csu_mulching`, source:`csu_soil_drainage`], what_to_do: 'Water slowly, so it soaks in instead of running off; if it runs off, water in several shorter sessions. A layer of mulch cuts the water lost from the surface and keeps the moisture steadier between waterings.' } RETURN NONE;
UPSERT soil_condition:['moisture', 'waterlogged'] CONTENT { description: 'The soil looks saturated, with standing water or puddles. Roots stop working without air, and if it stays this way most plants decline or die.', sources: [source:`csu_soil_drainage`, source:`isu_moss_lawn_garden`], what_to_do: 'Check the drainage, if you can, by digging a hole about 30 cm deep and filling it with water. If it hasn\'t drained in half an hour, the soil drains poorly. Water less, fill low spots or lead the water away, and work organic matter into the soil to open it up. Where water keeps standing, a raised bed lifts the roots above it.' } RETURN NONE;
UPSERT soil_condition:['moisture', 'wet'] CONTENT { description: 'The soil looks wet. Roots need air as well as water, and plants kept in wet soil root shallowly and are prone to root rot.', sources: [source:`csu_soil_drainage`, source:`csu_soil_compaction`, source:`isu_algae_lawn`], what_to_do: 'Let the surface dry before watering again, and avoid watering often or at night. Much surface wetness comes from watering too much or too often. Stay off the bed while it\'s wet, since wet soil packs down easily.' } RETURN NONE;
UPSERT soil_condition:['structure', 'cloddy'] CONTENT { description: 'The soil is in large, hard clods. Clods have few pores for roots, water and air. They form when soil with poor structure is dug or tilled, especially clay dug while wet, and can last for years.', sources: [source:`ontario_field_crops_soil_management`, source:`csu_soil_compaction`], what_to_do: 'Dig only when the soil is dry enough. A handful squeezed into a ball should crumble. If it only changes shape, it\'s too wet. Dig in organic matter, and keep the bed mulched instead of digging it often.' } RETURN NONE;
UPSERT soil_condition:['structure', 'compacted'] CONTENT { description: 'The soil looks packed and dense. Compaction squeezes out the large pores, so air and water move poorly, roots stay shallow, and plants grow weakly. It\'s hard to fix, and comes mostly from traffic, including feet on moist soil, and from heavy rain on bare clay.', sources: [source:`csu_soil_compaction`, source:`ontario_field_crops_soil_management`, source:`isu_moss_lawn_garden`], what_to_do: 'Keep off the bed, especially when it\'s wet, and use set paths or raised beds. Work organic matter into the top 15–20 cm and keep the surface mulched. In a lawn or under a tree, use a core aerator instead. Adding sand or gypsum doesn\'t loosen it.' } RETURN NONE;
UPSERT soil_condition:['surface', 'crusted'] CONTENT { description: 'A hard crust has formed on the surface. Rain or sprinkler drops break up the top layer of soil with poor structure, and it sets hard as it dries. A crust slows water soaking in, increases runoff, and can stop seedlings from coming up.', sources: [source:`ontario_field_crops_soil_management`, source:`csu_soil_compaction`, source:`csu_mulching`], what_to_do: 'Keep the surface covered with mulch, which takes the force of the drops. Add organic matter over time, which builds a structure that holds together when wet. Avoid working the soil when it\'s wet.' } RETURN NONE;
UPSERT soil_condition:['texture', 'clayey'] CONTENT { description: 'The jar test shows a clayey soil. Water moves slowly through its small pores, so it drains poorly and packs down easily. A soil with as little as a fifth clay behaves this way.', sources: [source:`csu_soil_texture`, source:`csu_soil_compaction`, source:`csu_soil_drainage`], what_to_do: 'Don\'t dig or walk on it while it\'s wet. Work organic matter into the top 15–20 cm and keep it mulched, which opens up larger pores. Adding sand doesn\'t help, and can make it set harder. Raised beds with paths keep feet off the growing soil.' } RETURN NONE;
UPSERT soil_condition:['texture', 'crumbles'] CONTENT { description: 'The moistened soil breaks apart when squeezed, a sign of a coarse, sandy soil. Water drains through it quickly, so it dries out fast.', sources: [source:`csu_soil_texture`, source:`csu_soil_drainage`], what_to_do: 'Add organic matter regularly to help it hold water, and mulch to cut drying.' } RETURN NONE;
UPSERT soil_condition:['texture', 'holds_ball'] CONTENT { description: 'The moistened soil holds a ball but changes shape easily, a sign of a medium texture, such as a sandy loam or a silt loam.', sources: [source:`csu_soil_texture`, source:`ontario_field_crops_soil_management`], what_to_do: 'Keep it that way by adding organic matter, such as compost, and keeping the surface covered.' } RETURN NONE;
UPSERT soil_condition:['texture', 'loamy'] CONTENT { description: 'The jar test shows a loam, a mix of sand, silt and clay.', sources: [source:`csu_soil_texture`, source:`ontario_field_crops_soil_management`], what_to_do: 'Keep it that way by adding organic matter, such as compost, and keeping the surface covered.' } RETURN NONE;
UPSERT soil_condition:['texture', 'sandy'] CONTENT { description: 'The jar test shows a sandy soil, mostly coarse particles. Water drains through it quickly, so it dries out fast.', sources: [source:`csu_soil_texture`, source:`csu_soil_drainage`], what_to_do: 'Add organic matter regularly to help it hold water, and mulch to cut drying.' } RETURN NONE;
UPSERT soil_condition:['texture', 'silty'] CONTENT { description: 'The jar test shows a soil high in silt, which feels smooth, like flour, when moist.', sources: [source:`csu_soil_texture`, source:`ontario_field_crops_soil_management`, source:`csu_mulching`], what_to_do: 'Add organic matter, which builds a structure that holds together when wet, and keep the surface mulched.' } RETURN NONE;
UPSERT soil_condition:['texture', 'sticky_ribbon'] CONTENT { description: 'The moistened soil is sticky and forms a ribbon, a sign of a fine, clayey soil. Water moves slowly through its small pores, so it drains poorly and packs down easily. A soil with as little as a fifth clay behaves this way.', sources: [source:`csu_soil_texture`, source:`csu_soil_compaction`, source:`csu_soil_drainage`], what_to_do: 'Don\'t dig or walk on it while it\'s wet. Work organic matter into the top 15–20 cm and keep it mulched, which opens up larger pores. Adding sand doesn\'t help, and can make it set harder. Raised beds with paths keep feet off the growing soil.' } RETURN NONE;
UPSERT soil_condition:['weeds', 'many'] CONTENT { description: 'Many weeds are growing in the bed.', sources: [source:`csu_mulching`, source:`csu_soil_compaction`], what_to_do: 'Remove them, then mulch the bed deep enough to suppress new ones, about 10 cm of wood chips or gravel. Avoid tilling, which brings buried weed seeds up to germinate. Plastic sheeting or weed fabric under the mulch isn\'t recommended in a garden bed.' } RETURN NONE;
