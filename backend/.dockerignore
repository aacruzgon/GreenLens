# The build context is backend/. Everything the crates embed (migrations/, openapi.json,
# fixtures/, testdata/, bioclip_templates.json) lives inside it and must stay in the context.
target/
tools/
# tests/ holds the Era fixtures, which tests read at run time and nothing embeds.
tests/
.git
**/*.rs.bk
**/.env
**/.env.*
# The build files: an edit to them must not change the context and force a full recompile.
Dockerfile
docker-bake.hcl
.dockerignore
