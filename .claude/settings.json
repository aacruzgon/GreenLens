{
  "extraKnownMarketplaces": {
    "clerk-skills": {
      "source": {
        "source": "github",
        "repo": "clerk/skills"
      }
    }
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "clerk@clerk-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-plugins.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
