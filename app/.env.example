# docs/frontend 17. Copy to .env and fill in. Nothing secret goes in an EXPO_PUBLIC_ value.

# Required: live or mock. mock runs the whole app on fixtures with no backend (docs/frontend 15).
EXPO_PUBLIC_API_MODE=mock

# Required in live mode. No trailing slash.
EXPO_PUBLIC_API_URL=

# Clerk's publishable key (pk_test_… or pk_live_…). Required in live mode.
# Leave it empty in mock mode to use the demo sign-in, which needs no account.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
