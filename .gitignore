# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon

# Resource forks and thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP shares
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# iCloud generated files
*.icloud

# ---------------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------------
*~

# Temporary files created if a process still has a handle open on a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# NFS temporary files
.nfs*

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
# Thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Dump files
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# ---------------------------------------------------------------------------
# Environment files
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
.vscode/

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC debug information
*.pdb

# ---------------------------------------------------------------------------
# Expo / React Native
# ---------------------------------------------------------------------------
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects generated by `npx expo prebuild`
ios/
android/
# ...but a local Expo module's native sources are written by hand (app/modules, roadmap F5).
!app/modules/*/ios/

# Native build artifacts and signing material
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Python / ML (ml/): datasets, caches, runs and model files never go in git
# ---------------------------------------------------------------------------
# No trailing slash on the data folders: a worktree often links them to the main checkout, and
# "dir/" matches only a directory, so `git add` would take the link (#210 did).
.venv
__pycache__/
*.pyc
.pytest_cache/
ml/training/data/raw
ml/training/data/cache
ml/training/runs
ml/models/files
ml/knowledge/.cache
ml/knowledge/build
ml/knowledge/raw
ml/training/eval/photos
ml/training/eval/faces
*.onnx
*.onnx.data
*.safetensors
*.pt
*.pth
ml/training/eval/reports/*/
