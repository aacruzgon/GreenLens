.venv/
__pycache__/
*.pyc
.pytest_cache/
ml/training/data/raw/
ml/training/data/cache/
ml/training/runs/
ml/models/files/
ml/training/eval/photos/
*.onnx
*.onnx.data
*.safetensors
*.pt
*.pth
ml/training/eval/reports/*/
