# api and the fallback worker run with cargo against infra/dev.compose.yml (docs/infra/README.md
# section 4). Throwaway values that match dev.compose.yml; nothing here works anywhere else.
#   cp infra/dev/.env.example infra/dev/.env          # infra/dev/.env is ignored by git
#   set -a; . infra/dev/.env; set +a                  # then, in backend/: cargo run -p api
# Fill in the values marked "yours" first. Clerk: the development instance only.

# --- api ----------------------------------------------------------------------------------------
SURREAL_URL=ws://127.0.0.1:18000
SURREAL_USER=api
SURREAL_PASS=api
SURREAL_ROOT_USER=root
SURREAL_ROOT_PASS=root
RUSTFS_ENDPOINT=http://127.0.0.1:19000
RUSTFS_ACCESS_KEY=TESTROOT
RUSTFS_SECRET_KEY=testrootsecret
RUSTFS_BUCKET=pdm-images
API_BIND=127.0.0.1:8080
API_PUBLIC_BASE=http://127.0.0.1:8080
API_URL_SIGNING_KEY=local-signing-key-at-least-32-bytes-long
WORKER_TOKENS=local-fallback-1=local-worker-token-at-least-32-bytes
LOG_FORMAT=pretty
# The CPU models: python3 ml/models/fetch.py --for api --dest ./models (vision 6).
MODELS_DIR=./models
# HEIC uploads need a local api built with `cargo run -p api --features heic` (and libheif installed);
# without it a HEIC upload is refused.
# ONNX Runtime 1.31.0 CPU, unpacked where setup 4 says; .dylib on macOS, .so on Linux.
ORT_DYLIB_PATH=/path/to/onnxruntime-1.31.0/lib/libonnxruntime.dylib
CLERK_ISSUER=https://yours.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_yours
# Must be whsec_ followed by base64, or api refuses to start. This is a placeholder that parses;
# the real secret comes from the Clerk webhook, which exists once the rig has a public URL.
CLERK_WEBHOOK_SECRET=whsec_dGhyb3dhd2F5LWRldi1zZWNyZXQtMDAwMDAwMDA=
LLM_API_KEY=sk-yours
# Optional: the poison-control answer, shown as written. Unset keeps a generic text with no numbers.
# Toronto demo:
# POISON_CONTROL_TEXT="Poisoning? Call the Ontario Poison Centre now: 1-800-268-9017 (24 hours), or 911 if the person is unwell. For a pet, call your vet or the Pet Poison Helpline: 1-855-764-7661 (a fee applies). Have the product label or a photo of the plant ready. Do not make anyone vomit unless they tell you to."
# Optional, yours: SurrealDB Agent Memory, a pdm-dev context and its narrowed key
# (docs/database/agent-memory.md section 2). All three or none; empty leaves it off.
AGENT_MEMORY_URL=
AGENT_MEMORY_CONTEXT_ID=
AGENT_MEMORY_API_KEY=
# Optional: farm connectors, off while CONNECTOR_KEY is empty. A local key: `openssl rand -hex 32`.
# The Era bases are the `era` profile's simulators; the Slack and Google clients stay empty locally.
# Set the two bases only together with CONNECTOR_KEY: without it api warns that they are unused.
CONNECTOR_KEY=
# ERA_SLACK_BASE=http://127.0.0.1:8091
# ERA_GOOGLE_BASE=http://127.0.0.1:8092
# Seeding the two era connectors also needs a garden of yours: its id from POST /gardens.
# ERA_DEMO_GARDEN_ID=

# --- the fallback worker (cargo run -p worker); LLM_API_KEY above is shared ---------------------
WORKER_CAPS=fallback
WORKER_ID=local-fallback-1
API_BASE_URL=http://127.0.0.1:8080
WORKER_TOKEN=local-worker-token-at-least-32-bytes
MODEL_MANIFEST=./models/manifest.toml

# --- a local stub perception worker (optional; cargo run -p worker, a second shell) -------------
# Answers perception jobs with canned results, so a scan runs without GPUs or model files.
# Its token must also be in api's WORKER_TOKENS above, as a comma-separated id=token pair:
#   WORKER_TOKENS=local-fallback-1=...,dev-stub-perception-1=<this token>
# A token is at least 32 bytes, and no two worker ids may share one.
# The label versions are those of an empty knowledge base; change them once the knowledge loads.
#WORKER_CAPS=perception
#WORKER_ID=dev-stub-perception-1
#WORKER_TOKEN=local-stub-token-at-least-32-bytes-long
#WORKER_STUB_VISION=true
#STUB_LABEL_SET_VERSION=d4f0f0534fb74a8d
#STUB_CLASSIFIER_LABELS_VERSION=
