# Copy to infra/.env and edit. Never commit infra/.env.

# Bearer key for the vLLM server. Required.
VLM_API_KEY=change-me
# GPU to use. Get it with: nvidia-smi --query-gpu=uuid --format=csv,noheader
VLM_GPU_UUID=GPU-xxxxxxxx

# Checkpoint and pinned revision: Qwen3.5-9B AWQ, chosen on 2026-10-20 (decision D1).
# The Qwen3-VL pairs are in infra/README.md section 4.
VLM_MODEL=cyankiwi/Qwen3.5-9B-AWQ-4bit
VLM_REVISION=156edc4bbeb8d1910ee7be9196bafaf1bc052156
# Concurrent sequences; equal to VLM_SLOTS of the vlm worker (2 on the 5070 Ti, from the day-2 benchmark).
VLM_MAX_NUM_SEQS=2
# Share of GPU memory vLLM takes: 0.78 with the desktop running, 0.90 for the FP8 fallback (nothing open on the desktop while it serves, or headless; infra/README.md 3).
VLM_GPU_MEM_UTIL=0.78
# Longest sequence in tokens.
VLM_MAX_MODEL_LEN=16384
# KV cache dtype: auto (BF16) or fp8.
VLM_KV_CACHE_DTYPE=auto
# Pixel budget per image. Change --limit-mm-per-prompt width/height in rig.compose.yml with it.
VLM_MAX_PIXELS=1003520
# Extra vllm serve flags, parsed by the shell. Qwen3.5 needs thinking off, which is also the
# compose file's default when this line is missing. Set it empty for Qwen3-VL.
VLM_EXTRA_ARGS='--default-chat-template-kwargs "{\"enable_thinking\": false}"'

# Host Hugging Face cache, mounted into the container. Default: ${HOME}/.cache/huggingface
# HF_HOME_HOST=/home/you/.cache/huggingface
# 1 = never download at start-up (checkpoints must already be cached).
HF_HUB_OFFLINE=1
