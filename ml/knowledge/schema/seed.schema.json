            "type": "string"
          },
          "type": "array"
        },
        "caused_by": {
          "description": "Organisms, for pest and wildlife problems.",
          "items": {
            "description": "knowledge-base id",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "type": "array"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions",
