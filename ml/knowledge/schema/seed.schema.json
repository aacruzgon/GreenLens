          "type": "array"
        },
        "treatments": {
          "description": "`manages` edges.",
          "items": {
            "description": "knowledge-base id",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "type": "array"
