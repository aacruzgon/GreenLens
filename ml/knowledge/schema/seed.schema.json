              "type": "string"
            },
            {
              "const": "biological",
              "description": "Biological.",
              "type": "string"
            },
            {
              "const": "mechanical",
              "description": "Mechanical.",
              "type": "string"
            },
            {
              "const": "chemical",
              "description": "Chemical.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
