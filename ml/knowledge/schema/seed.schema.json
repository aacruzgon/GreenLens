        "classifier_supported": {
          "description": "Checked against `classifier_labels.yaml` at ingestion.",
          "type": "boolean"
        },
        "common_names": {
          "description": "The first is the common name shown.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "The slug.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/SpeciesProfileKind",
          "description": "`label_only`: recognised by `BioCLIP`, no care profile or problems yet."
        },
        "reference_images": {
          "description": "At most 3, for the confirmation card.",
          "items": {
            "$ref": "#/$defs/ReferenceImageSeed"
