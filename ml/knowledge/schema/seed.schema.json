          "type": "array"
        },
        "id": {
          "description": "The slug.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "indicators": {
          "description": "Indicators; exactly 3 discriminating.",
          "items": {
            "$ref": "#/$defs/IndicatorSeed"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ProblemKind",
