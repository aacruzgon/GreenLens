            {
              "const": "leaf_closeup",
              "description": "At most 2.",
              "type": "string"
            },
            {
              "const": "leaf_underside",
              "description": "At most 1.",
              "type": "string"
            },
            {
              "const": "soil_surface",
              "description": "At most 1.",
              "type": "string"
            },
            {
              "const": "flower_fruit",
              "description": "At most 1.",
              "type": "string"
            },
            {
              "const": "squeeze_test",
              "description": "Guided soil check: at most 1 before submit, any number after.",
              "type": "string"
            },
            {
              "const": "jar_test",
              "description": "Guided soil check: at most 1 before submit, any number after.",
              "type": "string"
            }
          ]
        },
        "IndicatorMeasure": {
          "additionalProperties": false,
          "description": "`IndicatorMeasure` ([contracts 10]): at least one of `min` and `max`, in the quantity's\nunit, `min` < `max`.",
          "properties": {
            "max": {
              "description": "Upper bound.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "min": {
              "description": "Lower bound.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "quantity": {
              "$ref": "#/$defs/MeasureQuantity",
