        "name",
        "kind",
        "affects",
        "caused_by",
        "damage_patterns",
        "prevalence",
        "indicators",
        "conditions",
        "looks_like",
        "treatments",
        "sources",
        "reviewed_by",
        "reviewed_at"
      ],
      "title": "ProblemSeed",
      "type": "object"
    },
    "ProductsSeed": {
      "$defs": {
        "ProductSeed": {
          "additionalProperties": false,
          "description": "`ProductsSeed.products[]`.",
          "properties": {
            "broad_spectrum": {
              "description": "Harms beneficial insects too.",
              "type": "boolean"
            },
            "name": {
              "description": "Matched case-insensitively; a step naming one becomes chemical.",
              "type": "string"
            }
          },
          "required": [
            "name",
            "broad_spectrum"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`ProductsSeed` ([contracts 10]): `products.yaml`.",
      "properties": {
        "products": {
          "description": "Every pest-control product name.",
          "items": {
            "$ref": "#/$defs/ProductSeed"
          },
          "type": "array"
        }
      },
      "required": [
        "products"
      ],
      "title": "ProductsSeed",
      "type": "object"
    },
    "SoilConditionSeed": {
      "$defs": {
        "SoilAspect": {
          "description": "`SoilAspect` ([contracts 6], after decoding). `texture` comes from guided checks.",
          "oneOf": [
            {
              "const": "moisture",
              "description": "Moisture.",
              "type": "string"
            },
            {
              "const": "surface",
              "description": "Surface.",
              "type": "string"
            },
            {
              "const": "structure",
              "description": "Structure.",
              "type": "string"
            },
            {
              "const": "colour",
              "description": "Colour.",
              "type": "string"
            },
            {
              "const": "cover",
              "description": "Cover.",
              "type": "string"
            },
            {
              "const": "deposits",
              "description": "Deposits.",
              "type": "string"
            },
            {
              "const": "erosion",
              "description": "Erosion.",
              "type": "string"
            },
            {
              "const": "weeds",
              "description": "Weeds.",
              "type": "string"
            },
            {
              "const": "texture",
              "description": "From guided checks.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "One entry of `soil_conditions.yaml`: a description for each `SoilAspect` and value, with\nwhat to do and its sources ([contracts 10]; the file's shape is not spelled out there, so\nthis follows `schema.surql`'s `soil_condition` table).",
      "properties": {
        "aspect": {
          "$ref": "#/$defs/SoilAspect",
          "description": "The aspect."
        },
        "description": {
          "description": "What it means.",
          "type": "string"
        },
        "sources": {
          "description": "Sources.",
          "items": {
            "description": "knowledge-base id",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "type": "array"
        },
        "value": {
          "description": "The value, such as `\"compacted\"`.",
          "type": "string"
        },
        "what_to_do": {
          "description": "What to do.",
          "type": "string"
        }
      },
      "required": [
        "aspect",
        "value",
        "description",
        "what_to_do",
        "sources"
      ],
      "title": "SoilConditionSeed",
      "type": "object"
    },
    "SourceSeed": {
      "$defs": {
        "LocalDate": {
          "description": "A calendar date in the garden's time zone, `YYYY-MM-DD` ([contracts 1]). A newtype over\n`chrono::NaiveDate` (whose serde form is already `\"2026-10-20\"`) so the `OpenAPI` and JSON\nSchema generators see `format: date` through any alias, and so a UTC day can't be passed\nwhere a garden-local one is meant without saying so.",
          "format": "date",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`SourceSeed` ([contracts 10]): `sources.yaml`.",
      "properties": {
        "id": {
          "description": "The slug.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "licence": {
          "description": "Reuse terms; required for photo sources.",
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "description": "Publisher.",
          "type": "string"
        },
        "retrieved_at": {
          "$ref": "#/$defs/LocalDate",
          "description": "When it was retrieved."
        },
        "title": {
          "description": "Title.",
          "type": "string"
        },
        "url": {
          "description": "Its page.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "retrieved_at"
      ],
      "title": "SourceSeed",
      "type": "object"
    },
    "SpeciesSeed": {
      "$defs": {
        "Care": {
          "additionalProperties": false,
          "description": "`SpeciesSeed.care`: required when `profile` is `full`.",
          "properties": {
            "hardiness_zones": {
              "description": "Canadian plant hardiness zones, such as `\"annual\"` or `\"4-8\"`.",
              "type": [
                "string",
                "null"
              ]
            },
            "light": {
              "$ref": "#/$defs/LightNeed",
              "description": "Light."
            },
            "mature_height_cm": {
              "description": "The `growth_stalled` rule stops here.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "notes": {
              "description": "Notes.",
              "type": [
                "string",
                "null"
              ]
            },
            "soil_ph": {
              "$ref": "#/$defs/Range",
              "description": "Soil pH."
            },
            "spacing_cm": {
              "description": "Recommended distance between plants; the crowding rule.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "water": {
              "$ref": "#/$defs/WaterNeed",
              "description": "Water."
            }
          },
          "required": [
            "water",
            "light",
            "soil_ph"
          ],
          "type": "object"
        },
        "LightNeed": {
          "description": "`SpeciesSeed.care.light`.",
          "oneOf": [
            {
              "const": "full_sun",
              "description": "Full sun.",
              "type": "string"
            },
            {
              "const": "part_shade",
              "description": "Part shade.",
              "type": "string"
            },
            {
              "const": "shade",
              "description": "Shade.",
              "type": "string"
            }
          ]
        },
        "Range": {
          "additionalProperties": false,
          "description": "`ProblemSeed.conditions.temp_c` and `SpeciesSeed.care.soil_ph`.",
          "properties": {
            "max": {
              "description": "Upper bound.",
              "format": "double",
              "type": "number"
            },
            "min": {
              "description": "Lower bound.",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "type": "object"
        },
        "ReferenceImageSeed": {
          "additionalProperties": false,
          "description": "`SpeciesSeed.reference_images[]`.",
          "properties": {
            "credit": {
              "description": "\"Photo: A. Author, CC BY-SA 4.0\", shown with the photo.",
              "type": "string"
            },
            "file": {
              "description": "Under `ml/knowledge/seed/images/`, e.g. `\"species/tomato-1.jpg\"`.",
              "type": "string"
            },
            "source_id": {
              "description": "A source whose licence allows reuse with credit.",
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          },
          "required": [
            "file",
            "source_id",
            "credit"
          ],
          "type": "object"
        },
        "SpeciesProfileKind": {
          "description": "`SpeciesSummary.profile` and `SpeciesSeed.profile`.",
          "oneOf": [
            {
              "const": "full",
              "description": "Care profile and problems.",
              "type": "string"
            },
            {
              "const": "label_only",
              "description": "Recognised by `BioCLIP`, no care profile or problems yet.",
              "type": "string"
            }
          ]
        },
        "WaterNeed": {
          "description": "`SpeciesSeed.care.water`.",
          "oneOf": [
            {
              "const": "low",
              "description": "Low.",
              "type": "string"
            },
            {
              "const": "medium",
              "description": "Medium.",
              "type": "string"
            },
            {
              "const": "high",
              "description": "High.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`SpeciesSeed` ([contracts 10]): `species/<species_id>.yaml`.",
      "properties": {
        "bioclip_label": {
          "description": "The text prompt `BioCLIP` scores against.",
          "type": "string"
        },
        "care": {
          "anyOf": [
            {
              "$ref": "#/$defs/Care"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required when `full`."
