{
  "about": "Generated from the domain crate's seed types by its test the_seed_schema_file_is_current; set UPDATE_SEED_SCHEMA=1 to rewrite it.",
  "measurable_from": {
    "affected_area_pct": [
      "leaf_closeup",
      "leaf_underside"
    ],
    "canopy_width_cm": [
      "whole_plant"
    ],
    "hole_count": [
      "leaf_closeup",
      "leaf_underside"
    ],
    "hole_diameter_mm": [
      "leaf_closeup",
      "leaf_underside"
    ],
    "leaf_area_cm2": [
      "leaf_closeup",
      "leaf_underside"
    ],
    "leaf_length_cm": [
      "leaf_closeup",
      "leaf_underside"
    ],
    "lesion_count": [
      "leaf_closeup",
      "leaf_underside"
    ],
    "lesion_diameter_mm": [
      "leaf_closeup",
      "leaf_underside"
    ],
    "plant_height_cm": [
      "whole_plant"
    ]
  },
  "schemas": {
    "ChunkSeed": {
      "$defs": {
        "ChunkTopic": {
          "description": "`ChunkSeed.topic`.",
          "oneOf": [
            {
              "const": "symptoms",
              "description": "Symptoms.",
              "type": "string"
            },
            {
              "const": "conditions",
              "description": "Conditions.",
              "type": "string"
            },
            {
              "const": "management",
              "description": "Management.",
              "type": "string"
            },
            {
              "const": "care",
              "description": "Care.",
              "type": "string"
            },
            {
              "const": "recognition",
              "description": "Recognition.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`ChunkSeed` ([contracts 10]): one line of `chunks/<source_id>.jsonl`. Embeddings are\ncomputed at load time with the pinned model, never stored in the seed.",
      "properties": {
        "crop": {
          "description": "The crop.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "`\"<source_id>.<n>\"`.",
          "pattern": "^[a-z][a-z0-9_]*\\.[0-9]+$",
          "type": "string"
        },
        "organism": {
          "description": "The organism.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": [
            "string",
            "null"
          ]
        },
        "problem": {
          "description": "The problem.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "description": "The source.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "text": {
          "description": "A short excerpt, at most about 200 words.",
          "type": "string"
        },
        "topic": {
          "$ref": "#/$defs/ChunkTopic",
          "description": "The topic."
        }
      },
      "required": [
        "id",
        "source_id",
        "topic",
        "text"
      ],
      "title": "ChunkSeed",
      "type": "object"
    },
    "ClassifierLabels": {
      "$defs": {
        "ClassifierLabel": {
          "additionalProperties": false,
          "description": "`ClassifierLabels.labels[]`.",
          "properties": {
            "index": {
              "description": "The classifier's output index.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "label": {
              "description": "The training dataset's class name.",
              "type": "string"
            },
            "problem_id": {
              "description": "The problem, or `\"healthy\"`.",
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "species_id": {
              "description": "The species.",
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          },
          "required": [
            "index",
            "label",
            "species_id",
            "problem_id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`ClassifierLabels` ([contracts 10]): `classifier_labels.yaml`.",
      "properties": {
        "labels": {
          "description": "One per output.",
          "items": {
            "$ref": "#/$defs/ClassifierLabel"
          },
          "type": "array"
        },
        "model_version": {
          "description": "The classifier version these labels belong to.",
          "type": "string"
        }
      },
      "required": [
        "model_version",
        "labels"
      ],
      "title": "ClassifierLabels",
      "type": "object"
    },
    "OrganismSeed": {
      "$defs": {
        "SeedOrganismRole": {
          "description": "`OrganismSeed.role`: the seeded roles; `unknown` exists only for \"other\" findings.",
          "oneOf": [
