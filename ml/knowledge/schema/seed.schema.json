              "const": "pest",
              "description": "Pest.",
              "type": "string"
            },
            {
              "const": "beneficial",
              "description": "Beneficial.",
              "type": "string"
            },
            {
              "const": "neutral",
              "description": "Neutral.",
              "type": "string"
            },
            {
              "const": "invasive",
              "description": "Invasive: `reporting_url` required.",
              "type": "string"
            }
          ]
        },
        "TaxonGroup": {
          "description": "`OrganismSeed.taxon_group`.",
          "oneOf": [
            {
              "const": "insect",
              "description": "Insects.",
              "type": "string"
            },
            {
              "const": "mite",
              "description": "Mites.",
              "type": "string"
            },
            {
              "const": "mollusc",
              "description": "Slugs and snails.",
              "type": "string"
            },
            {
              "const": "worm",
              "description": "Worms.",
              "type": "string"
            },
            {
              "const": "mammal",
              "description": "Mammals.",
              "type": "string"
            },
            {
              "const": "bird",
              "description": "Birds.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`OrganismSeed` ([contracts 10]): `organisms/<organism_id>.yaml`.",
      "properties": {
        "bioclip_label": {
          "description": "`BioCLIP` prompt.",
          "type": "string"
        },
        "id": {
          "description": "The slug.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "name": {
          "description": "\"Ladybug larva\".",
          "type": "string"
        },
        "preys_on": {
          "description": "Beneficial → pest edges.",
          "items": {
            "description": "knowledge-base id",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "recognition": {
          "description": "How to recognise it in a photo.",
          "type": "string"
        },
        "reporting_url": {
          "description": "Required when invasive.",
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_by": {
          "description": "Reviewer.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SeedOrganismRole",
          "description": "Role."
        },
        "scientific_name": {
          "description": "Scientific name.",
          "type": "string"
        },
        "sources": {
          "description": "Sources.",
          "items": {
            "description": "knowledge-base id",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "type": "array"
        },
        "taxon_group": {
          "$ref": "#/$defs/TaxonGroup",
          "description": "Group."
        }
      },
      "required": [
        "id",
        "name",
        "scientific_name",
        "taxon_group",
        "role",
        "recognition",
        "bioclip_label",
        "sources",
        "reviewed_by"
      ],
      "title": "OrganismSeed",
      "type": "object"
    },
    "ProblemSeed": {
      "$defs": {
        "Conditions": {
