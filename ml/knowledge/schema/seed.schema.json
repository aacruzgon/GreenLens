          "type": [
            "array",
            "null"
          ]
        },
        "reviewed_by": {
          "description": "The reviewer.",
          "type": "string"
        },
        "scientific_name": {
          "description": "\"Solanum lycopersicum\".",
          "type": "string"
        },
        "sources": {
          "description": "May be empty for `label_only`.",
          "items": {
            "description": "knowledge-base id",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "scientific_name",
        "common_names",
        "profile",
        "classifier_supported",
        "bioclip_label",
        "sources",
        "reviewed_by"
      ],
      "title": "SpeciesSeed",
      "type": "object"
    },
