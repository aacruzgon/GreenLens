              "type": "integer"
            },
            "where": {
              "$ref": "#/$defs/IndicatorWhere",
              "description": "Where it shows."
            }
          },
          "required": [
            "id",
            "text",
            "question",
            "weight",
            "discriminating",
            "where",
            "image_kinds"
          ],
          "type": "object"
        },
        "IndicatorWhere": {
          "description": "`IndicatorWhere` ([contracts 10]): where on the plant an indicator shows.",
          "oneOf": [
            {
              "const": "lower_leaves",
              "description": "Lower leaves.",
              "type": "string"
            },
            {
              "const": "upper_leaves",
              "description": "Upper leaves.",
              "type": "string"
            },
            {
              "const": "whole_plant",
              "description": "The whole plant.",
              "type": "string"
            },
            {
              "const": "leaf_underside",
              "description": "The leaf underside.",
              "type": "string"
            },
            {
              "const": "stem",
              "description": "The stem.",
              "type": "string"
            },
            {
              "const": "fruit",
              "description": "The fruit.",
              "type": "string"
            },
            {
              "const": "soil",
              "description": "The soil.",
              "type": "string"
            }
          ]
        },
        "LocalDate": {
          "description": "A calendar date in the garden's time zone, `YYYY-MM-DD` ([contracts 1]). A newtype over\n`chrono::NaiveDate` (whose serde form is already `\"2026-10-20\"`) so the `OpenAPI` and JSON\nSchema generators see `format: date` through any alias, and so a UTC day can't be passed\nwhere a garden-local one is meant without saying so.",
          "format": "date",
          "type": "string"
        },
        "LooksLikeSeed": {
          "additionalProperties": false,
          "description": "`ProblemSeed.looks_like[]`, written once in either problem's file.",
          "properties": {
            "how_to_tell": {
              "description": "How to tell them apart.",
              "type": "string"
            },
            "problem": {
              "description": "The look-alike.",
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            }
          },
          "required": [
            "problem",
            "how_to_tell"
          ],
          "type": "object"
        },
        "MeasureQuantity": {
          "description": "`MeasureQuantity` ([contracts 7]). The unit is in the name.",
          "oneOf": [
            {
              "const": "plant_height_cm",
              "description": "From `whole_plant`: one value; needs gravity and a ground plane.",
              "type": "string"
            },
            {
              "const": "canopy_width_cm",
              "description": "From `whole_plant`: one value; needs gravity.",
              "type": "string"
            },
            {
              "const": "leaf_length_cm",
              "description": "Per leaf with a mask.",
              "type": "string"
            },
            {
              "const": "leaf_area_cm2",
              "description": "Per leaf with a mask.",
              "type": "string"
            },
            {
              "const": "lesion_diameter_mm",
              "description": "Per spot at least 4 pixels across.",
              "type": "string"
            },
            {
              "const": "lesion_count",
              "description": "Spots per leaf with a mask.",
              "type": "string"
            },
            {
              "const": "affected_area_pct",
              "description": "Share of each leaf covered by spots and their yellowing.",
              "type": "string"
            },
            {
              "const": "hole_diameter_mm",
              "description": "Per hole at least 4 pixels across.",
              "type": "string"
            },
            {
              "const": "hole_count",
              "description": "Holes per leaf with a mask, of any size.",
              "type": "string"
            }
          ]
        },
        "MeasureStat": {
          "description": "`IndicatorMeasure.stat`: which value of the measurement the range applies to.",
          "oneOf": [
            {
              "const": "median",
